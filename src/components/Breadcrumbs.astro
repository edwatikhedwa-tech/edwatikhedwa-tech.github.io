---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Хлебные крошки" class="mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-slate-600">
    <li>
      <a href="/" class="hover:text-blue-700 no-underline">Главная</a>
    </li>
    {items.map((item) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true" class="text-slate-400">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-blue-700 no-underline">{item.label}</a>
        ) : (
          <span aria-current="page" class="font-medium text-slate-900">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
