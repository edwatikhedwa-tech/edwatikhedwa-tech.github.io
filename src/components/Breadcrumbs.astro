---
interface Crumb {
  label: string;
  href?: string;
}

interface Props {
  items: Crumb[];
}

const { items } = Astro.props;
---

<nav aria-label="Хлебные крошки" class="mb-6">
  <ol class="flex flex-wrap items-center gap-2 text-sm text-[#4E5560]">
    <li>
      <a href="/" class="hover:text-[#9E1B1E] no-underline transition-colors">Главная</a>
    </li>
    {items.map((item) => (
      <li class="flex items-center gap-2">
        <span aria-hidden="true" class="text-[#B8B1A3]">/</span>
        {item.href ? (
          <a href={item.href} class="hover:text-[#9E1B1E] no-underline transition-colors">{item.label}</a>
        ) : (
          <span aria-current="page" class="font-semibold text-[#121519]">{item.label}</span>
        )}
      </li>
    ))}
  </ol>
</nav>
