<aside
  id="cookie-notice"
  hidden
  aria-label="Уведомление об использовании файлов cookie"
  class="fixed bottom-3 right-3 z-30 max-w-md border border-[#D6DAE2] bg-white/95 p-3.5 shadow-lg backdrop-blur-sm max-sm:left-3"
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-xs leading-snug text-[#4E5560]">
      Используем cookie и аналитику.{' '}
      <a href="/privacy/" class="text-[#9E1B1E] underline hover:text-[#7E1417]">Политика ПДн</a>
    </p>
    <button
      type="button"
      id="cookie-accept-btn"
      class="min-h-[36px] shrink-0 rounded-sm bg-[#121519] px-3.5 py-1.5 text-xs font-semibold text-white hover:bg-[#2a2f37] cursor-pointer"
    >
      Понятно
    </button>
  </div>
</aside>

<script>
  const notice = document.getElementById('cookie-notice');
  const acceptBtn = document.getElementById('cookie-accept-btn');
  try {
    if (notice && !localStorage.getItem('bebrand_spb_cookie_ack')) {
      notice.hidden = false;
    }
    acceptBtn?.addEventListener('click', () => {
      localStorage.setItem('bebrand_spb_cookie_ack', '1');
      if (notice) notice.hidden = true;
    });
  } catch {
    // Ignore storage access errors
  }
</script>
