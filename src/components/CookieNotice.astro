<aside
  id="cookie-notice"
  hidden
  aria-label="Уведомление об использовании файлов cookie"
  class="fixed bottom-4 left-4 right-4 z-30 mx-auto max-w-xl rounded-xl border border-slate-200 bg-white/95 p-4 shadow-lg backdrop-blur-sm sm:left-auto sm:right-6"
>
  <div class="flex flex-col gap-3 sm:flex-row sm:items-center sm:justify-between">
    <p class="text-xs leading-relaxed text-slate-600">
      Мы используем файлы cookie и веб-аналитику для работы калькулятора и улучшения сайта. Подробнее — в{' '}
      <a href="/privacy/" class="text-blue-700 underline hover:text-blue-800">Политике обработки ПДн</a>.
    </p>
    <button
      type="button"
      id="cookie-accept-btn"
      class="min-h-[40px] shrink-0 rounded-lg bg-slate-900 px-4 py-2 text-xs font-semibold text-white hover:bg-slate-800 cursor-pointer"
    >
      Понятно
    </button>
  </div>
</aside>

<script>
  const notice = document.getElementById('cookie-notice');
  const acceptBtn = document.getElementById('cookie-accept-btn');
  try {
    if (notice && !localStorage.getItem('bebrand_spb_cookie_ack')) {
      notice.hidden = false;
    }
    acceptBtn?.addEventListener('click', () => {
      localStorage.setItem('bebrand_spb_cookie_ack', '1');
      if (notice) notice.hidden = true;
    });
  } catch {
    // Ignore storage access errors in restricted environments
  }
</script>
