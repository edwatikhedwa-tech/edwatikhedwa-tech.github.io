<aside
  id="cookie-notice"
  hidden
  aria-label="Уведомление об использовании файлов cookie"
  class="border-b border-(--border-hairline) bg-(--bg-surface) px-4 py-2 text-(--ink-primary) sm:px-6 lg:fixed lg:right-3 lg:bottom-3 lg:z-30 lg:max-w-md lg:border lg:px-4 lg:shadow-sm"
>
  <div class="flex items-center justify-between gap-3">
    <p class="text-sm leading-normal text-(--ink-muted)">
      Используем cookie и аналитику.{' '}
      <a href="/privacy/" class="text-(--accent-crimson) underline underline-offset-2 hover:text-(--accent-crimson-hover)">Политика ПДн</a>
    </p>
    <button
      type="button"
      id="cookie-accept-btn"
      class="min-h-11 shrink-0 cursor-pointer rounded-sm border border-(--border-strong) px-3 text-sm font-medium text-(--ink-primary) hover:bg-(--bg-warm)"
    >
      Понятно
    </button>
  </div>
</aside>

<script>
  const notice = document.getElementById('cookie-notice');
  const acceptBtn = document.getElementById('cookie-accept-btn');
  try {
    if (notice && !localStorage.getItem('bebrand_spb_cookie_ack')) {
      notice.hidden = false;
    }
    acceptBtn?.addEventListener('click', () => {
      localStorage.setItem('bebrand_spb_cookie_ack', '1');
      if (notice) notice.hidden = true;
    });
  } catch {
    // Ignore storage access errors
  }
</script>
