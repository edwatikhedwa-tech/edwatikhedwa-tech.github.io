---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  headingId?: string;
  items: FaqItem[];
  openFirst?: boolean;
}

const {
  heading = 'Вопросы, с которыми чаще всего приходят предприниматели',
  headingId = 'faq-heading',
  items,
  openFirst = false,
} = Astro.props;
---

<section aria-labelledby={headingId} class="faq-accordion rounded-2xl border border-slate-200 bg-white p-6 sm:p-8">
  <h2 id={headingId} class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
    {heading}
  </h2>
  <div class="mt-6 border-t border-slate-200">
    {items.map((item, idx) => (
      <details open={openFirst && idx === 0} data-faq-item>
        <summary>{item.question}</summary>
        <div class="pb-5 pl-7 pr-2 text-base leading-relaxed text-slate-700">
          {item.answer}
        </div>
      </details>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-faq-item]').forEach((el) => {
    el.addEventListener('toggle', () => {
      if ((el as HTMLDetailsElement).open) {
        window.dispatchEvent(new CustomEvent('ym-goal', { detail: { goalId: 'goal_faq_expand' } }));
      }
    });
  });
</script>
