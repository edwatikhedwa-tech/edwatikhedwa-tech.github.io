---
export interface FaqItem {
  question: string;
  answer: string;
}

interface Props {
  heading?: string;
  headingId?: string;
  items: FaqItem[];
  openFirst?: boolean;
}

const {
  heading = 'Вопросы, с которыми чаще всего приходят предприниматели',
  headingId = 'faq-heading',
  items,
  openFirst = false,
} = Astro.props;
---

<section aria-labelledby={headingId} class="faq-accordion border border-[#D6DAE2] bg-white p-6 sm:p-8 lg:p-10">
  <h2 id={headingId} class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
    {heading}
  </h2>
  <hr class="mt-6 border-[#D6DAE2]" />
  <div>
    {items.map((item, idx) => (
      <details open={openFirst && idx === 0} data-faq-item>
        <summary>{item.question}</summary>
        <div class="max-w-xl pb-5 pl-7 pr-2 text-base leading-relaxed text-[#4E5560]">
          {item.answer}
        </div>
      </details>
    ))}
  </div>
</section>

<script>
  document.querySelectorAll('[data-faq-item]').forEach((el) => {
    el.addEventListener('toggle', () => {
      if ((el as HTMLDetailsElement).open) {
        window.dispatchEvent(new CustomEvent('ym-goal', { detail: { goalId: 'goal_faq_expand' } }));
      }
    });
  });
</script>
