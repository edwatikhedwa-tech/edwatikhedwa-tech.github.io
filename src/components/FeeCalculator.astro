---
import siteConfig from '../data/site-config.json';
import { calculateTrademarkBudget, formatRub } from '../data/calculator';

interface Props {
  headingId?: string;
}

const { headingId = 'calc-heading' } = Astro.props;

const initial = calculateTrademarkBudget({
  designationType: 'word',
  classesCount: 1,
  extraItemsCount: 0,
  speed: 'standard',
  certificateFormat: 'electronic',
  bureauStandardPrice: siteConfig.prices.trademarkStandard,
  bureauAcceleratedPrice: siteConfig.prices.trademarkAccelerated,
});
---

<section
  id="calculator"
  aria-labelledby={headingId}
  class="border border-[#121519] bg-white shadow-[6px_6px_0_0_#D6DAE2]"
  data-bureau-std={siteConfig.prices.trademarkStandard}
  data-bureau-acc={siteConfig.prices.trademarkAccelerated}
>
  <div class="border-b border-[#D6DAE2] bg-[#ECEEF2]/60 px-6 py-6 sm:px-8 lg:px-10">
    <div class="max-w-3xl">
      <h2 id={headingId} class="text-2xl font-semibold tracking-tight text-[#121519] sm:text-3xl">
        Калькулятор пошлин Роспатента и стоимости регистрации товарного знака (2026)
      </h2>
      <p class="mt-1.5 text-xs font-semibold uppercase tracking-[0.12em] text-[#9E1B1E]">
        Актуально на ноябрь 2026 года
      </p>
      <p class="mt-2.5 text-sm sm:text-base text-[#4E5560]">
        Государственные пошлины оплачиваются напрямую в бюджет в два этапа: при подаче заявки и после положительного решения
        экспертизы (через 6–9 месяцев). С 4 октября 2025 года по ПП РФ № 1459 за каждую позицию сверх 10 в одном классе МКТУ
        взимается доплата 500 ₽.
      </p>
    </div>
  </div>

  <div class="grid lg:grid-cols-12">
    <!-- Левая панель: контролы -->
    <div class="space-y-6 p-6 sm:p-8 lg:col-span-7 lg:p-10">
      <fieldset>
        <legend class="text-sm font-semibold text-[#121519]">1. Тип обозначения</legend>
        <div class="mt-2.5 grid gap-2.5 sm:grid-cols-3">
          <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2.5 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC] has-[:checked]:text-[#9E1B1E]">
            <input type="radio" name="calc_designation" value="word" checked class="accent-[#9E1B1E]" />
            <span>Словесное</span>
          </label>
          <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2.5 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC] has-[:checked]:text-[#9E1B1E]">
            <input type="radio" name="calc_designation" value="figurative" class="accent-[#9E1B1E]" />
            <span>Изобразительное</span>
          </label>
          <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2.5 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC] has-[:checked]:text-[#9E1B1E]">
            <input type="radio" name="calc_designation" value="combined" class="accent-[#9E1B1E]" />
            <span>Комбинированное</span>
          </label>
        </div>
      </fieldset>

      <div class="grid gap-5 sm:grid-cols-2">
        <div>
          <label for="calc-classes" class="block text-sm font-semibold text-[#121519]">
            2. Количество классов МКТУ (1–45)
          </label>
          <div class="mt-2 flex items-center gap-3">
            <input
              id="calc-classes"
              type="range"
              min="1"
              max="45"
              value="1"
              class="w-full accent-[#9E1B1E] cursor-pointer"
            />
            <input
              id="calc-classes-num"
              type="number"
              min="1"
              max="45"
              value="1"
              aria-label="Количество классов МКТУ числом"
              class="w-20 min-h-[44px] rounded-sm border border-[#B8B1A3] px-2.5 text-center text-sm font-semibold tabular-nums"
            />
          </div>
          <p class="mt-1.5 text-xs text-[#4E5560]">За каждый доп. класс: +3 500 ₽ при подаче; от 6-го класса: +2 000 ₽ на этапе выдачи.</p>
        </div>

        <div>
          <label for="calc-extra-items" class="block text-sm font-semibold text-[#121519]">
            3. Позиций сверх 10 в классах
          </label>
          <div class="mt-2 flex items-center gap-3">
            <input
              id="calc-extra-items"
              type="range"
              min="0"
              max="100"
              value="0"
              class="w-full accent-[#9E1B1E] cursor-pointer"
            />
            <input
              id="calc-extra-items-num"
              type="number"
              min="0"
              max="100"
              value="0"
              aria-label="Количество позиций сверх 10 числом"
              class="w-20 min-h-[44px] rounded-sm border border-[#B8B1A3] px-2.5 text-center text-sm font-semibold tabular-nums"
            />
          </div>
          <p class="mt-1.5 text-xs text-[#4E5560]">До 10 позиций в каждом классе входят в базовую пошлину; свыше — +500 ₽/поз.</p>
        </div>
      </div>

      <div class="grid gap-5 sm:grid-cols-2">
        <fieldset>
          <legend class="text-sm font-semibold text-[#121519]">4. Срок рассмотрения</legend>
          <div class="mt-2.5 space-y-2">
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC]">
              <input type="radio" name="calc_speed" value="standard" checked class="accent-[#9E1B1E]" />
              <span>Стандартный (6–9 мес.)</span>
            </label>
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC]">
              <input type="radio" name="calc_speed" value="accelerated" class="accent-[#9E1B1E]" />
              <span>Ускоренный (2–3 мес.)</span>
            </label>
          </div>
        </fieldset>

        <fieldset>
          <legend class="text-sm font-semibold text-[#121519]">5. Формат свидетельства</legend>
          <div class="mt-2.5 space-y-2">
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC]">
              <input type="radio" name="calc_cert" value="electronic" checked class="accent-[#9E1B1E]" />
              <span>Электронное (0 ₽)</span>
            </label>
            <label class="flex min-h-[48px] cursor-pointer items-center gap-2.5 rounded-sm border border-[#B8B1A3] px-3.5 py-2 text-sm font-medium text-[#121519] has-[:checked]:border-[#9E1B1E] has-[:checked]:bg-[#F9ECEC]">
              <input type="radio" name="calc_cert" value="paper" class="accent-[#9E1B1E]" />
              <span>Бумажное (+3 000 ₽)</span>
            </label>
          </div>
        </fieldset>
      </div>
    </div>

    <!-- Правая панель: смета -->
    <div class="flex flex-col justify-between border-t border-[#D6DAE2] bg-[#F7F8FA] p-6 sm:p-8 lg:col-span-5 lg:border-t-0 lg:border-l lg:p-10">
      <div>
        <h3 class="text-lg font-bold text-[#121519]">Предварительная смета бюджета</h3>
        <dl class="mt-5 divide-y divide-[#D6DAE2] text-sm">
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-[#4E5560]">Этап 1: пошлина при подаче</dt>
            <dd id="out-stage1" class="font-semibold text-[#121519] tabular-nums">{formatRub(initial.stage1Fee)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-[#4E5560]">Этап 2: пошлина после решения (6–9 мес.)</dt>
            <dd id="out-stage2" class="font-semibold text-[#121519] tabular-nums">{formatRub(initial.stage2Fee)}</dd>
          </div>
          <div id="row-fips" hidden class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-[#4E5560]">Тариф ФИПС за ускорение (вкл. НДС 22%)</dt>
            <dd id="out-fips" class="font-semibold text-[#9E1B1E] tabular-nums">0 ₽</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 py-3">
            <dt class="text-[#4E5560]">
              Услуги BeBrand СПб
              <span class="block text-xs text-[#4E5560]">({siteConfig.prices.isReference ? 'федеральный ориентир' : 'тариф СПб'})</span>
            </dt>
            <dd id="out-bureau" class="font-semibold text-[#121519] tabular-nums">от {formatRub(initial.bureauFee)}</dd>
          </div>
          <div class="flex items-baseline justify-between gap-4 pt-4">
            <dt class="text-base font-bold text-[#121519]">Итого (пошлины + услуги)</dt>
            <dd id="out-total" class="font-display text-3xl font-bold text-[#9E1B1E] tabular-nums">от {formatRub(initial.grandTotal)}</dd>
          </div>
        </dl>
      </div>

      <div class="mt-6">
        <button
          type="button"
          id="calc-submit-btn"
          class="w-full min-h-[48px] rounded-sm bg-[#9E1B1E] px-5 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#7E1417] cursor-pointer"
        >
          Получить расчёт с подбором классов МКТУ
        </button>
        <p class="mt-3 text-xs leading-relaxed text-[#4E5560]">
          Расчёт выполнен по Положению о патентных и иных пошлинах (ред. ПП РФ от 23.09.2025 № 1459) и Прейскуранту платных
          услуг ФИПС (ред. Приказа № 107 от 27.02.2026). Скидка 30% за электронную подачу не действует с 05.10.2024.
        </p>
      </div>
    </div>
  </div>
</section>

<script>
  import { calculateTrademarkBudget, formatRub, type DesignationType, type ReviewSpeed, type CertificateFormat } from '../data/calculator';

  const root = document.getElementById('calculator');
  if (root) {
    const bureauStandardPrice = Number(root.dataset.bureauStd || 39900);
    const bureauAcceleratedPrice = Number(root.dataset.bureauAcc || 46000);

    const classesRange = document.getElementById('calc-classes') as HTMLInputElement;
    const classesNum = document.getElementById('calc-classes-num') as HTMLInputElement;
    const extraRange = document.getElementById('calc-extra-items') as HTMLInputElement;
    const extraNum = document.getElementById('calc-extra-items-num') as HTMLInputElement;

    const outStage1 = document.getElementById('out-stage1')!;
    const outStage2 = document.getElementById('out-stage2')!;
    const rowFips = document.getElementById('row-fips')!;
    const outFips = document.getElementById('out-fips')!;
    const outBureau = document.getElementById('out-bureau')!;
    const outTotal = document.getElementById('out-total')!;
    const submitBtn = document.getElementById('calc-submit-btn')!;

    let interacted = false;

    const getState = () => {
      const designationType = ((document.querySelector('input[name="calc_designation"]:checked') as HTMLInputElement)?.value || 'word') as DesignationType;
      const speed = ((document.querySelector('input[name="calc_speed"]:checked') as HTMLInputElement)?.value || 'standard') as ReviewSpeed;
      const certificateFormat = ((document.querySelector('input[name="calc_cert"]:checked') as HTMLInputElement)?.value || 'electronic') as CertificateFormat;
      const classesCount = Math.max(1, Math.min(45, Number(classesNum.value) || 1));
      const extraItemsCount = Math.max(0, Math.min(100, Number(extraNum.value) || 0));
      return { designationType, classesCount, extraItemsCount, speed, certificateFormat };
    };

    const render = () => {
      const s = getState();
      const res = calculateTrademarkBudget({
        ...s,
        bureauStandardPrice,
        bureauAcceleratedPrice,
      });

      outStage1.textContent = formatRub(res.stage1Fee);
      outStage2.textContent = formatRub(res.stage2Fee);

      if (res.fipsAccelerationFee > 0) {
        rowFips.hidden = false;
        outFips.textContent = formatRub(res.fipsAccelerationFee);
      } else {
        rowFips.hidden = true;
      }

      outBureau.textContent = 'от ' + formatRub(res.bureauFee);
      outTotal.textContent = 'от ' + formatRub(res.grandTotal);
    };

    const markInteracted = () => {
      if (!interacted) {
        interacted = true;
        window.dispatchEvent(new CustomEvent('ym-goal', { detail: { goalId: 'goal_calc_interact' } }));
      }
    };

    classesRange.addEventListener('input', () => {
      classesNum.value = classesRange.value;
      markInteracted();
      render();
    });
    classesNum.addEventListener('input', () => {
      const val = Math.max(1, Math.min(45, Number(classesNum.value) || 1));
      classesRange.value = String(val);
      markInteracted();
      render();
    });

    extraRange.addEventListener('input', () => {
      extraNum.value = extraRange.value;
      markInteracted();
      render();
    });
    extraNum.addEventListener('input', () => {
      const val = Math.max(0, Math.min(100, Number(extraNum.value) || 0));
      extraRange.value = String(val);
      markInteracted();
      render();
    });

    root.querySelectorAll('input[type="radio"]').forEach((radio) => {
      radio.addEventListener('change', () => {
        markInteracted();
        render();
      });
    });

    submitBtn.addEventListener('click', () => {
      const s = getState();
      const res = calculateTrademarkBudget({ ...s, bureauStandardPrice, bureauAcceleratedPrice });
      const speedLabel = s.speed === 'accelerated' ? 'Ускоренный (2–3 мес.)' : 'Стандартный (6–9 мес.)';
      const certLabel = s.certificateFormat === 'paper' ? 'Бумажное' : 'Электронное';
      const summary = `Расчёт из калькулятора: классов МКТУ — ${s.classesCount}, доп. позиций >10 — ${s.extraItemsCount}, срок — ${speedLabel}, свидетельство — ${certLabel}. Пошлины: ${formatRub(res.totalStateFee + res.fipsAccelerationFee)}.`;

      window.dispatchEvent(new CustomEvent('open-check-modal', {
        detail: {
          goalId: 'goal_calc_submit',
          direction: 'Товарный знак',
          prefillTask: summary,
        },
      }));
    });
  }
</script>
