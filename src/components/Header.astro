---
import siteConfig from '../data/site-config.json';

interface Props {
  currentPath?: string;
}

const { currentPath = '/' } = Astro.props;

const services = [
  {
    href: '/tovarnye-znaki/',
    title: 'Товарные знаки',
    desc: 'Проверка ФИПС, МКТУ, стандартная, ускоренная и международная регистрация',
  },
  {
    href: '/patentovanie/',
    title: 'Патентование',
    desc: 'Изобретения, полезные модели, промышленные образцы, льготы МСП −65%',
  },
  {
    href: '/programmy-evm-i-reestr-po/',
    title: 'Программы ЭВМ и Реестр ПО',
    desc: 'Регистрация в Роспатенте (5 000 ₽) и включение в Реестр Минцифры',
  },
  {
    href: '/dogovory-i-franshiza/',
    title: 'Договоры и франшиза',
    desc: 'Концессия, лицензии, отчуждение прав в ФИПС, авторские договоры',
  },
  {
    href: '/zashchita-i-spory/',
    title: 'Защита и споры',
    desc: 'WB/Ozon по 289-ФЗ, предотказы, ППС, ФАС, арбитраж и СИП',
  },
];
---

<header class="sticky top-0 z-40 border-b border-[#D6DAE2] bg-[#F7F8FA]/95 backdrop-blur-sm">
  <div class="mx-auto flex max-w-7xl items-center justify-between gap-4 px-4 py-3.5 sm:px-6 lg:px-8">
    <a href="/" class="flex items-center gap-3 text-[#121519] no-underline shrink-0">
      <!-- Фирменный геральдический щит BEBRAND -->
      <svg class="h-9 w-9 shrink-0" viewBox="0 0 36 36" fill="none" aria-hidden="true">
        <path d="M5 4.5h26v15.4c0 6.8-5.4 11.7-13 14.1C10.4 31.6 5 26.7 5 19.9V4.5Z" fill="#9E1B1E" />
        <path d="M12.5 10.5h7.2a3.8 3.8 0 0 1 0 7.6H12.5v-7.6Zm0 7.6h5.6l4.4 6.4h-3.1l-4.1-6h-2.8v6" stroke="#FFFFFF" stroke-width="2" stroke-linecap="round" stroke-linejoin="round" />
      </svg>
      <div class="leading-none">
        <span class="block text-base font-bold tracking-[0.12em] text-[#121519] uppercase">BEBRAND</span>
        <span class="mt-1 block text-[11px] font-medium tracking-wide text-[#4E5560]">Санкт-Петербург</span>
      </div>
    </a>

    <nav class="hidden lg:flex lg:items-center lg:gap-7" aria-label="Основная навигация">
      <div class="relative group">
        <button
          type="button"
          class="inline-flex items-center gap-1.5 py-2 text-sm font-medium text-[#121519] hover:text-[#9E1B1E] cursor-pointer transition-colors"
          aria-expanded="false"
          aria-haspopup="true"
          id="nav-services-btn"
        >
          Услуги
          <svg class="h-4 w-4 text-[#4E5560] transition-transform group-hover:rotate-180" viewBox="0 0 20 20" fill="currentColor" aria-hidden="true">
            <path fill-rule="evenodd" d="M5.23 7.21a.75.75 0 011.06.02L10 11.168l3.71-3.938a.75.75 0 111.08 1.04l-4.25 4.5a.75.75 0 01-1.08 0l-4.25-4.5a.75.75 0 01.02-1.06z" clip-rule="evenodd" />
          </svg>
        </button>
        <div
          id="nav-services-menu"
          class="invisible opacity-0 group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100 absolute left-0 top-full pt-2 w-[26rem] transition-opacity duration-150"
        >
          <div class="border border-[#D8D3C8] bg-white p-2 shadow-xl">
            {services.map((item) => (
              <a
                href={item.href}
                aria-current={currentPath === item.href ? 'page' : undefined}
                class:list={[
                  'block px-3.5 py-2.5 no-underline transition-colors hover:bg-[#F6F4EF] border-l-2',
                  currentPath === item.href ? 'border-[#9E1B1E] bg-[#F9ECEC]/50 text-[#9E1B1E]' : 'border-transparent text-[#121519]',
                ]}
              >
                <span class="block text-sm font-semibold">{item.title}</span>
                <span class="block text-xs text-[#4E5560] mt-0.5">{item.desc}</span>
              </a>
            ))}
          </div>
        </div>
      </div>

      <a
        href="/tseny-i-poshliny/"
        aria-current={currentPath === '/tseny-i-poshliny/' ? 'page' : undefined}
        class:list={[
          'py-2 text-sm font-medium no-underline transition-colors',
          currentPath === '/tseny-i-poshliny/' ? 'text-[#9E1B1E] font-semibold' : 'text-[#121519] hover:text-[#9E1B1E]',
        ]}
      >
        Цены и пошлины
      </a>
      <a
        href="/o-kompanii/"
        aria-current={currentPath === '/o-kompanii/' ? 'page' : undefined}
        class:list={[
          'py-2 text-sm font-medium no-underline transition-colors',
          currentPath === '/o-kompanii/' ? 'text-[#9E1B1E] font-semibold' : 'text-[#121519] hover:text-[#9E1B1E]',
        ]}
      >
        О компании
      </a>
      <a
        href="/kontakty/"
        aria-current={currentPath === '/kontakty/' ? 'page' : undefined}
        class:list={[
          'py-2 text-sm font-medium no-underline transition-colors',
          currentPath === '/kontakty/' ? 'text-[#9E1B1E] font-semibold' : 'text-[#121519] hover:text-[#9E1B1E]',
        ]}
      >
        Контакты
      </a>
    </nav>

    <div class="hidden md:flex md:items-center md:gap-5">
      <div class="text-right leading-tight">
        <a
          href={`tel:${siteConfig.contacts.phoneHref}`}
          data-ym-goal="goal_click_phone"
          class="block text-sm font-semibold text-[#121519] hover:text-[#9E1B1E] no-underline tabular-nums transition-colors"
        >
          {siteConfig.contacts.phoneDisplay}
        </a>
        <span class="block text-[11px] text-[#4E5560]">Пн–Пт 09:00–18:00</span>
      </div>
      <button
        type="button"
        data-open-check-modal
        command="show-modal"
        commandfor="check-modal"
        class="inline-flex min-h-[44px] items-center justify-center rounded-sm bg-[#9E1B1E] px-5 py-2 text-sm font-semibold text-white transition-colors hover:bg-[#7E1417] cursor-pointer"
      >
        Проверить обозначение
      </button>
    </div>

    <div class="flex items-center gap-2 lg:hidden">
      <button
        type="button"
        data-open-check-modal
        command="show-modal"
        commandfor="check-modal"
        class="inline-flex min-h-[44px] items-center justify-center rounded-sm bg-[#9E1B1E] px-3.5 py-2 text-xs sm:text-sm font-semibold text-white hover:bg-[#7E1417] cursor-pointer"
      >
        Проверить знак
      </button>
      <button
        type="button"
        id="mobile-menu-toggle"
        aria-expanded="false"
        aria-controls="mobile-nav-panel"
        aria-label="Открыть меню навигации"
        class="inline-flex min-h-[44px] min-w-[44px] items-center justify-center rounded-sm border border-[#D8D3C8] bg-white text-[#121519] hover:bg-[#EDE9E0] cursor-pointer"
      >
        <svg class="h-6 w-6" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" aria-hidden="true">
          <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </button>
    </div>
  </div>

  <div id="mobile-nav-panel" hidden class="border-t border-[#D8D3C8] bg-[#F6F4EF] px-4 py-4 lg:hidden">
    <div class="space-y-1">
      <p class="px-2 pt-1 pb-1 text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Услуги</p>
      {services.map((item) => (
        <a
          href={item.href}
          class="block px-2 py-2.5 text-sm font-medium text-[#121519] hover:bg-[#EDE9E0] no-underline"
        >
          {item.title}
        </a>
      ))}
      <div class="my-2 border-t border-[#D8D3C8]"></div>
      <a href="/tseny-i-poshliny/" class="block px-2 py-2.5 text-sm font-medium text-[#121519] hover:bg-[#EDE9E0] no-underline">Цены и пошлины</a>
      <a href="/o-kompanii/" class="block px-2 py-2.5 text-sm font-medium text-[#121519] hover:bg-[#EDE9E0] no-underline">О компании</a>
      <a href="/kontakty/" class="block px-2 py-2.5 text-sm font-medium text-[#121519] hover:bg-[#EDE9E0] no-underline">Контакты</a>
      <div class="mt-3 pt-3 border-t border-[#D8D3C8] px-2">
        <a href={`tel:${siteConfig.contacts.phoneHref}`} data-ym-goal="goal_click_phone" class="block text-base font-semibold text-[#9E1B1E] no-underline tabular-nums">
          {siteConfig.contacts.phoneDisplay}
        </a>
        <span class="block text-xs text-[#4E5560] mt-0.5">{siteConfig.contacts.workingHours}</span>
      </div>
    </div>
  </div>
</header>

<script>
  const toggleBtn = document.getElementById('mobile-menu-toggle');
  const mobilePanel = document.getElementById('mobile-nav-panel');
  if (toggleBtn && mobilePanel) {
    toggleBtn.addEventListener('click', () => {
      const expanded = toggleBtn.getAttribute('aria-expanded') === 'true';
      toggleBtn.setAttribute('aria-expanded', String(!expanded));
      mobilePanel.hidden = expanded;
    });
  }
</script>
