---
import siteConfig from '../data/site-config.json';

interface Props {
  formId: string;
  goalId: string;
  title?: string;
  subtitle?: string;
  submitLabel?: string;
  showDirectionSelector?: boolean;
  directions?: string[];
  defaultDirection?: string;
  showMeetingFormat?: boolean;
  taskLabel?: string;
  taskPlaceholder?: string;
}

const {
  formId,
  goalId,
  title,
  subtitle,
  submitLabel = 'Отправить запрос',
  showDirectionSelector = false,
  directions = [
    'Товарный знак',
    'Патентование',
    'ПО / Реестр Минцифры',
    'Договор / Франшиза',
    'Спор / Маркетплейсы',
  ],
  defaultDirection = directions[0],
  showMeetingFormat = false,
  taskLabel = 'Название бренда или краткое описание задачи',
  taskPlaceholder = 'Например: регистрация названия кофейни в СПб по 43 классу МКТУ',
} = Astro.props;
---

<form
  id={formId}
  action={siteConfig.leadEndpoint || '#lead-submit'}
  method="POST"
  data-goal-id={goalId}
  data-lead-form
  novalidate
  class="space-y-4"
>
  {title && <h3 class="text-xl font-bold text-[#121519]">{title}</h3>}
  {subtitle && <p class="text-sm text-[#4E5560]">{subtitle}</p>}

  <div class="visually-hidden" aria-hidden="true">
    <label for={`${formId}-company-site`}>Оставьте это поле пустым</label>
    <input type="text" id={`${formId}-company-site`} name="website_hp" tabindex="-1" autocomplete="off" />
  </div>

  {showDirectionSelector && (
    <fieldset>
      <legend class="block text-sm font-semibold text-[#121519]">Направление задачи</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {directions.map((dir) => (
          <label class="cursor-pointer">
            <input
              type="radio"
              name="direction"
              value={dir}
              checked={dir === defaultDirection}
              class="peer visually-hidden"
            />
            <span class="pill-radio-label">
              {dir}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )}

  {showMeetingFormat && (
    <fieldset>
      <legend class="block text-sm font-semibold text-[#121519]">Формат консультации</legend>
      <div class="mt-2 flex flex-wrap gap-2">
        {['В офисе в СПб', 'Видеозвонок', 'Телефон'].map((fmt, idx) => (
          <label class="cursor-pointer">
            <input type="radio" name="meeting_format" value={fmt} checked={idx === 0} class="peer visually-hidden" />
            <span class="pill-radio-label">
              {fmt}
            </span>
          </label>
        ))}
      </div>
    </fieldset>
  )}

  <div>
    <label for={`${formId}-task`} class="block text-sm font-semibold text-[#121519]">
      {taskLabel}
    </label>
    <textarea
      id={`${formId}-task`}
      name="task"
      rows="2"
      placeholder={taskPlaceholder}
      class="field-input mt-1.5 resize-y"
    ></textarea>
  </div>

  <div class="grid gap-4 sm:grid-cols-2">
    <div>
      <label for={`${formId}-name`} class="block text-sm font-semibold text-[#121519]">
        Ваше имя <span class="text-[#9E1B1E]" aria-hidden="true">*</span>
      </label>
      <input
        id={`${formId}-name`}
        name="name"
        type="text"
        required
        autocomplete="name"
        data-error={`${formId}-name-error`}
        class="field-input mt-1.5"
      />
      <div id={`${formId}-name-error`} class="error-msg">
        <span role="img" aria-label="Ошибка">✕</span> Укажите, как к вам обращаться.
      </div>
    </div>

    <div>
      <label for={`${formId}-contact`} class="block text-sm font-semibold text-[#121519]">
        Телефон или Telegram <span class="text-[#9E1B1E]" aria-hidden="true">*</span>
      </label>
      <input
        id={`${formId}-contact`}
        name="contact"
        type="text"
        required
        autocomplete="tel"
        autocorrect="off"
        autocapitalize="none"
        data-error={`${formId}-contact-error`}
        class="field-input mt-1.5"
      />
      <div id={`${formId}-contact-error`} class="error-msg">
        <span role="img" aria-label="Ошибка">✕</span> Укажите номер телефона или @ник в Telegram.
      </div>
    </div>
  </div>

  <div>
    <div class="flex items-start gap-2.5">
      <input
        id={`${formId}-consent`}
        name="consent"
        type="checkbox"
        required
        data-error={`${formId}-consent-error`}
        class="mt-1 h-5 w-5 shrink-0 rounded-sm border-[#B8B1A3] accent-[#9E1B1E] cursor-pointer"
      />
      <label for={`${formId}-consent`} class="text-xs leading-relaxed text-[#4E5560] cursor-pointer">
        Соглашаюсь с <a href="/privacy/" class="text-[#9E1B1E] underline hover:text-[#7E1417]">Политикой обработки персональных данных</a> (152-ФЗ)
      </label>
    </div>
    <div id={`${formId}-consent-error`} class="error-msg">
      <span role="img" aria-label="Ошибка">✕</span> Необходимо согласие на обработку персональных данных.
    </div>
  </div>

  <button
    type="submit"
    class="w-full min-h-[48px] rounded-sm bg-[#9E1B1E] px-6 py-3 text-sm font-semibold text-white transition-colors hover:bg-[#7E1417] disabled:opacity-60 cursor-pointer"
  >
    {submitLabel}
  </button>

  <div
    data-form-success
    hidden
    role="status"
    class="border border-emerald-700/30 bg-emerald-50 p-4 text-sm text-emerald-950"
  >
    <p class="font-semibold">Запрос принят.</p>
    <p class="mt-1">
      Специалист офиса BeBrand в Санкт-Петербурге свяжется с вами в ближайшее рабочее время. Если вопрос срочный,
      позвоните нам по номеру{' '}
      <a href={`tel:${siteConfig.contacts.phoneHref}`} class="font-semibold underline">
        {siteConfig.contacts.phoneDisplay}
      </a>.
    </p>
  </div>
</form>
