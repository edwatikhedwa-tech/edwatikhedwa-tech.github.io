---
const scenarios = [
  {
    id: 'marketplaces',
    label: 'Маркетплейсы и СТМ',
    title: 'Конкуренты копируют карточку или выходят под вашим брендом на WB и Ozon?',
    text: 'Зарегистрированный товарный знак и патент на упаковку дают законное основание для блокировки нарушителей на маркетплейсах. Мы фиксируем нарушение, готовим претензию и подаём обращение через «Цифровой арбитраж» WB, поддержку Ozon либо в суд за компенсацией (сроки и итог зависят от регламентов площадок и документов).',
    tools: ['Товарный знак на бренд (слово / логотип)', 'Патент на промышленный образец упаковки', 'Досудебные претензии и жалобы на площадках'],
    links: [
      { label: 'Регистрация товарного знака →', href: '/tovarnye-znaki/' },
      { label: 'Защита и споры на маркетплейсах →', href: '/zashchita-i-spory/' },
    ],
  },
  {
    id: 'horeca',
    label: 'Общепит, ритейл и франшизы',
    title: 'Вывеска на латинице, открытие новой точки или продажа франшизы?',
    text: 'Зарегистрированный товарный знак закрепляет право использовать оригинальное название на фасаде и в меню с учётом языковых требований (ст. 10.1 ЗоЗПП / Закон № 168-ФЗ) и защищает от претензий третьих лиц. При масштабировании сети готовим и регистрируем договор коммерческой концессии в Роспатенте (ст. 1027 ГК РФ).',
    tools: ['Регистрация знака обслуживания и логотипа', 'Договор коммерческой концессии (франшиза) в Роспатенте', 'Лицензионные договоры внутри сети'],
    links: [
      { label: 'Договоры и франшиза →', href: '/dogovory-i-franshiza/' },
      { label: 'Регистрация товарного знака →', href: '/tovarnye-znaki/' },
    ],
  },
  {
    id: 'manufacturing',
    label: 'Производство и инженерия',
    title: 'Разработали устройство, технологию или дизайн изделия и опасаетесь копирования?',
    text: 'Без патента конкуренты могут законно воспроизвести конструкцию или форму продукта. Мы проводим патентный поиск по базам ФИПС, выбираем оптимальную охрану (изобретение, полезная модель или промобразец) и подаём заявку в Роспатент (для компаний из реестра МСП и единственных авторов действуют законные льготы по пошлинам).',
    tools: ['Патент на изобретение, полезную модель, промобразец', 'Патентный поиск по базам данных ФИПС', 'Оформление подтверждения льгот для малого бизнеса'],
    links: [
      { label: 'Патентование в СПб →', href: '/patentovanie/' },
      { label: 'Цены и таблица льгот →', href: '/tseny-i-poshliny/' },
    ],
  },
  {
    id: 'it',
    label: 'IT-компании и разработчики ПО',
    title: 'Нужно подтвердить права на код перед инвестором, заказчиком или Реестром Минцифры?',
    text: 'Регистрация программы для ЭВМ в Роспатенте фиксирует дату и правообладателя. Мы оформляем свидетельство, выстраиваем служебные задания и договоры с разработчиками для подтверждения чистоты прав, а также готовим пакет документов для Единого реестра российского ПО (условия налоговых льгот проверяются индивидуально).',
    tools: ['Свидетельство Роспатента на программу для ЭВМ / БД', 'Подготовка документов для Реестра Минцифры', 'Договоры об отчуждении и служебные задания с авторами'],
    links: [
      { label: 'Программы ЭВМ и Реестр ПО →', href: '/programmy-evm-i-reestr-po/' },
      { label: 'Договоры на разработку →', href: '/dogovory-i-franshiza/' },
    ],
  },
];
---

<section aria-labelledby="scenarios-heading" class="py-14 sm:py-16">
  <div class="max-w-xl">
    <h2 id="scenarios-heading" class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
      Какие задачи бизнеса мы решаем в 2026 году
    </h2>
    <p class="mt-3 text-base text-[#4E5560]">
      Выберите отраслевой сценарий Санкт-Петербурга и Ленинградской области, чтобы увидеть актуальные правовые инструменты.
    </p>
  </div>

  <div class="mt-8 border border-[#D6DAE2] bg-white" data-scenario-tabs>
    <div
      role="tablist"
      focusgroup="tablist nomemory"
      aria-label="Отраслевые сценарии бизнеса"
      class="flex overflow-x-auto border-b border-[#D6DAE2] bg-[#ECEEF2]/60 px-3 sm:px-6"
    >
      {scenarios.map((tab, idx) => (
        <button
          type="button"
          role="tab"
          id={`tab-${tab.id}`}
          aria-selected={idx === 0 ? 'true' : 'false'}
          tabindex={idx === 0 ? 0 : -1}
          focusgroupstart={idx === 0 ? '' : undefined}
          data-tab-target={`panel-${tab.id}`}
          class="min-h-[54px] whitespace-nowrap px-4 py-3.5 text-sm font-semibold text-[#4E5560] hover:text-[#121519] cursor-pointer transition-colors"
        >
          {tab.label}
        </button>
      ))}
    </div>

    <div class="grid">
      {scenarios.map((tab, idx) => (
        <div
          id={`panel-${tab.id}`}
          role="tabpanel"
          aria-labelledby={`tab-${tab.id}`}
          tabindex={idx === 0 ? 0 : undefined}
          hidden={idx !== 0 ? 'until-found' : undefined}
          class="col-start-1 row-start-1"
        >
          <div class="grid lg:grid-cols-12">
            <div class="p-6 sm:p-8 lg:col-span-7">
              <h3 class="text-xl font-bold text-[#121519]">{tab.title}</h3>
              <p class="mt-3 max-w-xl text-base leading-relaxed text-[#4E5560]">{tab.text}</p>
            </div>
            <div class="flex flex-col justify-between border-t border-[#D6DAE2] bg-[#F7F8FA] p-6 sm:p-8 lg:col-span-5 lg:border-t-0 lg:border-l">
              <div>
                <p class="text-xs font-semibold uppercase tracking-[0.12em] text-[#4E5560]">Инструменты защиты</p>
                <ul class="mt-4 space-y-3 text-sm font-medium text-[#121519]">
                  {tab.tools.map((tool) => (
                    <li class="flex items-start gap-2.5">
                      <span class="mt-1.5 h-1.5 w-1.5 shrink-0 bg-[#9E1B1E]" aria-hidden="true"></span>
                      <span>{tool}</span>
                    </li>
                  ))}
                </ul>
              </div>
              <hr class="my-5 border-[#D6DAE2]" />
              <div class="flex flex-col gap-2.5">
                {tab.links.map((link) => (
                  <a href={link.href} class="text-sm font-semibold text-[#9E1B1E] hover:text-[#7E1417] no-underline">
                    {link.label}
                  </a>
                ))}
              </div>
            </div>
          </div>
        </div>
      ))}
    </div>
  </div>
</section>

<script>
  const container = document.querySelector('[data-scenario-tabs]');
  if (container) {
    const tabs = Array.from(container.querySelectorAll<HTMLButtonElement>('[role="tab"]'));
    const panels = Array.from(container.querySelectorAll<HTMLElement>('[role="tabpanel"]'));

    const selectTab = (selectedTab: HTMLButtonElement, moveFocus = false) => {
      const targetId = selectedTab.dataset.tabTarget;
      tabs.forEach((tab) => {
        const isSelected = tab === selectedTab;
        tab.setAttribute('aria-selected', String(isSelected));
        tab.tabIndex = isSelected ? 0 : -1;
        tab.toggleAttribute('focusgroupstart', isSelected);
      });
      panels.forEach((panel) => {
        const isTarget = panel.id === targetId;
        if (isTarget) {
          panel.removeAttribute('hidden');
          panel.tabIndex = 0;
        } else {
          panel.setAttribute('hidden', 'until-found');
          panel.removeAttribute('tabindex');
        }
      });
      selectedTab.scrollIntoView({ block: 'nearest', inline: 'nearest' });
      if (moveFocus) selectedTab.focus();
    };

    tabs.forEach((tab, index) => {
      tab.addEventListener('click', () => {
        selectTab(tab);
        window.dispatchEvent(new CustomEvent('ym-goal', { detail: { goalId: 'goal_scenario_tab' } }));
      });

      tab.addEventListener('keydown', (e) => {
        let nextIndex = -1;
        if (e.key === 'ArrowRight') nextIndex = (index + 1) % tabs.length;
        else if (e.key === 'ArrowLeft') nextIndex = (index - 1 + tabs.length) % tabs.length;
        else if (e.key === 'Home') nextIndex = 0;
        else if (e.key === 'End') nextIndex = tabs.length - 1;

        if (nextIndex !== -1) {
          e.preventDefault();
          selectTab(tabs[nextIndex], true);
        }
      });
    });

    panels.forEach((panel) => {
      panel.addEventListener('beforematch', () => {
        const tab = tabs.find((t) => t.dataset.tabTarget === panel.id);
        if (tab) selectTab(tab);
      });
    });
  }
</script>
