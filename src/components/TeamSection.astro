---
import siteConfig from '../data/site-config.json';

const federalAttorneys = [
  {
    name: 'Екатерина Каранаева',
    number: 'Патентный поверенный РФ № 2149',
    role: 'Руководитель подразделения по регистрации товарных знаков и программ для ЭВМ (федеральный центр BeBrand).',
    href: '/tovarnye-znaki/',
  },
  {
    name: 'Наталья Сергеева',
    number: 'Патентный поверенный РФ № 2150',
    role: 'Руководитель подразделения оформления патентов, стаж 15 лет (изобретения, полезные модели, промышленные образцы).',
    href: '/patentovanie/',
  },
  {
    name: 'Анна Кузнецова',
    number: 'Патентный поверенный РФ № 2314',
    role: 'Руководитель подразделения судебной практики (Палата по патентным спорам, ФАС, арбитражные суды и СИП).',
    href: '/zashchita-i-spory/',
  },
  {
    name: 'Диана Зонова',
    number: 'Руководитель патентной практики',
    role: 'Заместитель генерального директора, руководитель патентной практики федеральной сети BeBrand.',
    href: '/o-kompanii/',
  },
];
---

<section aria-labelledby="team-heading" class="py-14 sm:py-16">
  <div class="max-w-3xl">
    <h2 id="team-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
      Кто отвечает за ваш проект
    </h2>
    <p class="mt-3 text-base text-slate-600">
      В Санкт-Петербурге проект координирует локальный руководитель, а правовую позицию и документы готовят
      аттестованные патентные поверенные РФ головного центра BeBrand.
    </p>
  </div>

  <div class="mt-8 grid gap-6 lg:grid-cols-12">
    <article class="rounded-2xl border-2 border-blue-200 bg-blue-50/50 p-6 lg:col-span-5">
      <span class="inline-block rounded-md bg-blue-700 px-2.5 py-1 text-xs font-semibold text-white">
        Офис в Санкт-Петербурге
      </span>
      <h3 class="mt-4 text-xl font-bold text-slate-900">{siteConfig.spbLead.name}</h3>
      <p class="mt-1 text-sm font-medium text-blue-800">{siteConfig.spbLead.role}</p>
      <p class="mt-3 text-sm leading-relaxed text-slate-700">{siteConfig.spbLead.bio}</p>
      <div class="mt-5 border-t border-blue-200 pt-4 text-xs text-slate-600">
        Очные встречи в СПб и сопровождение по СЗФО ·{' '}
        <a href="/kontakty/" class="font-semibold text-blue-700 hover:underline">Записаться на встречу →</a>
      </div>
    </article>

    <div class="grid gap-4 sm:grid-cols-2 lg:col-span-7">
      {federalAttorneys.map((person) => (
        <article class="flex flex-col justify-between rounded-xl border border-slate-200 bg-white p-5">
          <div>
            <span class="inline-block rounded-md bg-slate-100 px-2.5 py-1 text-xs font-semibold text-slate-700">
              {person.number}
            </span>
            <h3 class="mt-3 text-lg font-bold text-slate-900">{person.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">{person.role}</p>
          </div>
          <a href={person.href} class="mt-4 inline-block text-xs font-semibold text-blue-700 hover:underline no-underline">
            Профильная практика →
          </a>
        </article>
      ))}
    </div>
  </div>

  <p class="mt-6 text-sm text-slate-600">
    Номера аттестации патентных поверенных РФ (№ 2149, № 2150, № 2314) открыты для проверки в официальном Реестре
    патентных поверенных на сайте Роспатента.{' '}
    <a href="/o-kompanii/" class="font-semibold text-blue-700 hover:underline">Подробнее о структуре офиса и федеральной сети →</a>
  </p>
</section>
