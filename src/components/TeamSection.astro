---
import siteConfig from '../data/site-config.json';

const federalAttorneys = [
  {
    name: 'Екатерина Каранаева',
    number: 'Патентный поверенный РФ № 2149',
    role: 'Руководитель подразделения по регистрации товарных знаков и программ для ЭВМ (федеральный центр BeBrand).',
    href: '/tovarnye-znaki/',
  },
  {
    name: 'Наталья Сергеева',
    number: 'Патентный поверенный РФ № 2150',
    role: 'Руководитель подразделения оформления патентов, стаж 15 лет (изобретения, полезные модели, промышленные образцы).',
    href: '/patentovanie/',
  },
  {
    name: 'Анна Кузнецова',
    number: 'Патентный поверенный РФ № 2314',
    role: 'Руководитель подразделения судебной практики (Палата по патентным спорам, ФАС, арбитражные суды и СИП).',
    href: '/zashchita-i-spory/',
  },
  {
    name: 'Диана Зонова',
    number: 'Руководитель патентной практики',
    role: 'Заместитель генерального директора, руководитель патентной практики федеральной сети BeBrand.',
    href: '/o-kompanii/',
  },
];
---

<section aria-labelledby="team-heading" class="py-14 sm:py-16">
  <div class="max-w-3xl">
    <h2 id="team-heading" class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
      Кто отвечает за ваш проект
    </h2>
    <p class="mt-3 text-base text-[#4E5560]">
      В Санкт-Петербурге проект координирует локальный руководитель, а правовую позицию и документы готовят
      аттестованные патентные поверенные РФ головного центра BeBrand.
    </p>
  </div>

  <div class="mt-8 grid border border-[#D6DAE2] bg-white lg:grid-cols-12">
    <article class="flex flex-col justify-between border-b border-[#D6DAE2] border-l-4 border-l-[#9E1B1E] bg-[#F7F8FA] p-6 sm:p-8 lg:col-span-5 lg:border-b-0 lg:border-r">
      <div>
        <span class="inline-block bg-[#9E1B1E] px-2.5 py-1 text-xs font-semibold uppercase tracking-wider text-white">
          Офис в Санкт-Петербурге
        </span>
        <h3 class="mt-4 text-xl font-bold text-[#121519]">{siteConfig.spbLead.name}</h3>
        <p class="mt-1 text-sm font-semibold text-[#9E1B1E]">{siteConfig.spbLead.role}</p>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">{siteConfig.spbLead.bio}</p>
      </div>
      <hr class="my-5 border-[#D6DAE2]" />
      <div class="text-xs text-[#4E5560]">
        Очные встречи в СПб и сопровождение по СЗФО ·{' '}
        <a href="/kontakty/" class="font-semibold text-[#9E1B1E] hover:underline no-underline">Записаться на встречу →</a>
      </div>
    </article>

    <div class="grid divide-y divide-[#D6DAE2] sm:grid-cols-2 sm:divide-y-0 lg:col-span-7">
      {federalAttorneys.map((person, idx) => (
        <article class:list={[
          'flex flex-col justify-between p-6',
          idx >= 2 ? 'sm:border-t sm:border-[#D6DAE2]' : '',
          idx % 2 === 1 ? 'sm:border-l sm:border-[#D6DAE2]' : '',
        ]}>
          <div>
            <span class="inline-block bg-[#ECEEF2] px-2.5 py-1 text-xs font-semibold text-[#121519] tabular-nums">
              {person.number}
            </span>
            <h3 class="mt-3 text-lg font-bold text-[#121519]">{person.name}</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-[#4E5560]">{person.role}</p>
          </div>
          <a href={person.href} class="mt-4 inline-block text-xs font-semibold text-[#9E1B1E] hover:underline no-underline">
            Профильная практика →
          </a>
        </article>
      ))}
    </div>
  </div>

  <p class="mt-6 text-sm text-[#4E5560]">
    Номера аттестации патентных поверенных РФ (№ 2149, № 2150, № 2314) открыты для проверки в официальном Реестре
    патентных поверенных на сайте Роспатента.{' '}
    <a href="/o-kompanii/" class="font-semibold text-[#9E1B1E] hover:underline">Подробнее о структуре офиса и федеральной сети →</a>
  </p>
</section>
