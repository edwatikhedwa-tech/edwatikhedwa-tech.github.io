---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScenarioTabs from '../components/ScenarioTabs.astro';
import FeeCalculator from '../components/FeeCalculator.astro';
import TeamSection from '../components/TeamSection.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import YandexMapLazy from '../components/YandexMapLazy.astro';
import siteConfig from '../data/site-config.json';
import { formatRub } from '../data/calculator';

const faqItems: FaqItem[] = [
  {
    question: 'Нужно ли переводить вывеску и сайт на русский язык по закону 168-ФЗ, если зарегистрировать товарный знак?',
    answer:
      'Зарегистрированный товарный знак переводить не требуется: ст. 10.1 Закона о защите прав потребителей прямо исключает зарегистрированные обозначения и знаки обслуживания из требований об обязательном переводе. Однако сопутствующая потребительская информация (режим работы, навигация, ценники) должна оформляться на русском языке. Бюро помогает проверить статус обозначений и исключить претензии надзорных органов.',
  },
  {
    question: 'Могут ли физические лица и самозанятые зарегистрировать товарный знак?',
    answer:
      'Да. Физические лица и самозанятые граждане вправе регистрировать и владеть товарными знаками наравне с ИП и компаниями. Оформлять отдельное юридическое лицо для подачи заявки не требуется.',
  },
  {
    question: 'Почему госпошлины на товарный знак у разных компаний сильно отличаются?',
    answer:
      'Размер пошлин зависит от числа классов МКТУ и количества позиций: по Постановлению Правительства РФ № 1459 за каждую позицию сверх 10 в одном классе предусмотрена дополнительная пошлина. Мы заранее формируем выверенный перечень товаров и услуг, чтобы заявитель не переплачивал за лишние позиции в Роспатент.',
  },
  {
    question: 'Защищает ли уже зарегистрированное название ООО или домен от претензий правообладателя?',
    answer:
      'Нет, регистрация домена или создание ООО не дают автоматического права на бренд. Если другое лицо зарегистрирует тождественный или сходный товарный знак в Роспатенте, оно сможет законно потребовать прекращения использования обозначения на вывеске, сайте и маркетплейсах, а также взыскания компенсации по ст. 1515 ГК РФ.',
  },
  {
    question: 'Как распределяются роли между офисом в Санкт-Петербурге и головным центром?',
    answer:
      'Офис в Санкт-Петербурге отвечает за стратегию, договор и итоговый результат проекта: от очных консультаций и аудита рисков до представительства в судах СПб и ЛО. К узкоспециализированной экспертизе в Роспатенте, ППС и СИП подключаются профильные аттестованные патентные поверенные РФ сети BeBrand.',
  },
  {
    question: 'Обеспечивается ли конфиденциальность до подачи патентной заявки?',
    answer:
      'Да. До передачи описаний, чертежей или исходных кодов оформляется соглашение о конфиденциальности (NDA), гарантирующее защиту коммерческой тайны и авторских наработок.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LegalService',
      name: siteConfig.fullBrandTitle,
      url: `${siteConfig.siteUrl}/`,
      logo: `${siteConfig.siteUrl}/favicon.svg`,
      telephone: siteConfig.contacts.phoneHref,
      email: siteConfig.contacts.email,
      areaServed: [
        { '@type': 'City', name: 'Санкт-Петербург' },
        { '@type': 'AdministrativeArea', name: 'Ленинградская область' },
      ],
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'RU',
        addressRegion: 'Санкт-Петербург',
        addressLocality: siteConfig.contacts.city,
        postalCode: siteConfig.contacts.postalCode,
        streetAddress: siteConfig.contacts.streetAddress,
      },
      openingHours: siteConfig.contacts.openingHoursIso,
      priceRange: '₽₽',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};

const servicesCatalog = [
  {
    name: 'Товарные знаки',
    desc: 'Проверка по базам ФИПС, подбор и оптимизация МКТУ (экономия на пошлинах по ПП № 1459), стандартная и ускоренная регистрация, международная охрана, продление.',
    term: '6–9 мес. (стандарт) / 2–3 мес. (ускоренно)',
    price: `от ${formatRub(siteConfig.prices.trademarkStandard)}`,
    href: '/tovarnye-znaki/',
  },
  {
    name: 'Патентование',
    desc: 'Изобретения (технологии, составы, способы), полезные модели (устройства), промышленные образцы (дизайн изделия, упаковка, интерфейс), патентный поиск и чистота.',
    term: 'Зависит от объекта патентования',
    price: `от ${formatRub(siteConfig.prices.industrialDesign)} (промобразец) / от ${formatRub(siteConfig.prices.utilityModel)} (модель)`,
    href: '/patentovanie/',
  },
  {
    name: 'Программы ЭВМ и Реестр ПО',
    desc: 'Госрегистрация программ для ЭВМ и баз данных в Роспатенте; подготовка юридического и технического пакета для Единого реестра российского ПО Минцифры.',
    term: '2–6 мес. (Роспатент)',
    price: `от ${formatRub(siteConfig.prices.softwareEvm)}`,
    href: '/programmy-evm-i-reestr-po/',
  },
  {
    name: 'Договоры, франшиза и авторское право',
    desc: 'Разработка и регистрация в Роспатенте договоров коммерческой концессии, лицензионных договоров и договоров отчуждения прав; авторские договоры и депонирование.',
    term: '~2 мес. (регистрация в ФИПС)',
    price: `от ${formatRub(siteConfig.prices.franchiseContract)} (концессия) / от ${formatRub(siteConfig.prices.licenseContract)} (лицензия)`,
    href: '/dogovory-i-franshiza/',
  },
  {
    name: 'Защита прав, споры и суды',
    desc: 'Преодоление предварительных отказов Роспатента, снятие контрафакта на WB/Ozon, претензии, ФАС, ППС, Суд по интеллектуальным правам, аннулирование ТЗ.',
    term: 'Досудебная претензия — 30 дней по закону',
    price: `от ${formatRub(siteConfig.prices.annulment)} (аннулирование при ликвидации) / расчёт по делу`,
    href: '/zashchita-i-spory/',
  },
  {
    name: 'Нейминг и доработка знака',
    desc: 'Создание патентоспособных названий и логотипов, доработка обозначения при выявлении сходных знаков в Роспатенте.',
    term: 'По ТЗ',
    price: 'По запросу',
    href: '#lead-form-section',
  },
];

const steps = [
  {
    num: '01',
    title: 'Диагностика задачи и проверка обозначения',
    term: '1–2 рабочих дня',
    desc: 'Проверяем название и логотип по зарегистрированным знакам и поданным заявкам в базах ФИПС, оцениваем основания отказа по ст. 1483 ГК РФ и подбираем классы МКТУ без лишних доплат.',
    doc: 'Письменное заключение о рисках и рекомендации по доработке (при наличии препятствий).',
  },
  {
    num: '02',
    title: 'Договор, фиксация сметы и подача заявки',
    term: 'до 5 рабочих дней',
    desc: 'Фиксируем в договоре объём работ, стоимость и конфиденциальность, готовим квитанции на 1-ю часть госпошлины и подаём заявку в Роспатент электронно.',
    doc: 'Уведомление о поступлении заявки (Форма 940) с закреплённой датой приоритета.',
  },
  {
    num: '03',
    title: 'Формальная экспертиза и экспертиза по существу',
    term: '1–3 мес. и 6–9 мес. (либо 2–3 мес. суммарно при ускорении)',
    desc: 'Сопровождаем делопроизводство, готовим правовые ответы на запросы и предварительные уведомления ФИПС, контролируем процессуальные сроки.',
    doc: 'Уведомления о стадиях и Решение о государственной регистрации.',
  },
  {
    num: '04',
    title: 'Оплата финальной пошлины и получение свидетельства',
    term: 'до 2 месяцев после оплаты',
    desc: 'Формируем платёж на 2-ю часть госпошлины и контролируем внесение записи в Государственный реестр Роспатента.',
    doc: 'Официальное свидетельство о регистрации (электронное с усиленной подписью Роспатента и по желанию бумажный оригинал) и комплект закрывающих документов.',
  },
];
---

<BaseLayout
  title="Патентное бюро BeBrand в СПб — товарные знаки, патенты, защита ИС"
  description="Офис федеральной сети BeBrand в Санкт-Петербурге: регистрация товарных знаков, патенты, Реестр ПО, договоры франшизы и защита в суде. 4 103 зарегистрированных товарных знака за год (IRPA 2026). Расчёт пошлин 2026."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- Блок 1: Hero -->
  <section aria-labelledby="hero-heading" class="border-b border-(--border-hairline) bg-(--bg-paper) py-10 sm:py-14 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-center gap-8 md:grid-cols-12 lg:gap-12">
        <div class="hero-animate md:col-span-7">
          <p class="flex items-center gap-2 text-sm font-medium text-(--ink-muted)">
            <span aria-hidden="true" class="size-1.5 shrink-0 rounded-full bg-(--accent-crimson)"></span>
            Патентное бюро · Санкт-Петербург
          </p>
          <h1 id="hero-heading" class="mt-3 max-w-[16ch] text-[clamp(2.35rem,5vw,3.75rem)] leading-[1.06] font-semibold">
            Защита брендов и технологий
          </h1>
          <p class="mt-4 max-w-lg text-base leading-relaxed text-(--ink-muted) sm:text-lg">
            Регистрируем товарные знаки, патентуем разработки и защищаем права в спорах. Согласуем смету до начала работы.
          </p>

          <div class="mt-6 flex flex-wrap items-center gap-x-6 gap-y-2">
            <button
              type="button"
              data-open-check-modal
              command="show-modal"
              commandfor="check-modal"
              class="inline-flex min-h-12 cursor-pointer items-center justify-center rounded-sm bg-(--accent-crimson) px-5 py-3 text-center text-base font-semibold text-(--bg-surface) hover:bg-(--accent-crimson-hover)"
            >
              Проверить знак или задачу
            </button>
            <a href="#calculator" class="inline-flex min-h-11 items-center gap-2 text-sm font-medium text-(--ink-primary) underline decoration-(--border-strong) underline-offset-4 hover:text-(--accent-crimson)">
              Рассчитать пошлины 2026 <span aria-hidden="true">↓</span>
            </a>
          </div>
        </div>

        <!-- Краткая выдержка из досье; детали в блоке экспертизы -->
        <aside aria-labelledby="hero-dossier" class="hero-animate w-full max-w-lg border border-(--border-hairline) bg-(--bg-surface) text-(--ink-primary) md:col-span-5 md:justify-self-end">
          <div class="border-b border-(--border-hairline) px-5 py-3 sm:px-7">
            <h2 id="hero-dossier" class="font-sans text-sm leading-snug font-semibold tracking-wide text-(--ink-muted)">
              Досье BeBrand
            </h2>
          </div>
          <div class="p-5 sm:p-7">
            <p class="font-display text-4xl leading-none font-semibold tabular-nums lg:text-5xl">С 2013 года</p>
            <p class="mt-2 text-sm leading-relaxed text-(--ink-muted)">
              ООО «БизБренд» зарегистрировано 28 августа 2013 года.
            </p>
            <a
              href="https://irpa-rating.com/bizbrand"
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="mt-2 inline-flex min-h-11 items-center gap-2 text-sm font-medium text-(--accent-crimson) underline underline-offset-4 hover:text-(--accent-crimson-hover)"
            >
              Карточка компании в IRPA <span aria-hidden="true">↗</span><span class="sr-only"> (откроется в новой вкладке)</span>
            </a>
          </div>
        </aside>
      </div>
    </div>
  </section>

  <!-- Блок 2: Маршрутизатор сценариев -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ScenarioTabs />
  </div>

  <!-- Блок 3: Реестр услуг -->
  <section aria-labelledby="catalog-heading" class="bg-white py-14 sm:py-16 border-y border-[#D6DAE2]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-[68ch]">
        <h2 id="catalog-heading" class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
          Направления практики и услуги
        </h2>
        <p class="mt-3 text-base text-[#4E5560]">
          Сопровождаем весь цикл работы с нематериальными активами: от проверки чистоты идеи до защиты исключительных прав
          в Палате по патентным спорам и судах.
        </p>
      </div>

      <div tabindex="0" role="region" aria-label="Таблица направлений практики и услуг" class="table-wrapper mt-8">
        <table class="data-table data-table--stack">
          <thead>
            <tr>
              <th>Направление</th>
              <th>Что делаем</th>
              <th>Типовой срок</th>
              <th>Фиксированный гонорар за этап*</th>
              <th>Переход</th>
            </tr>
          </thead>
          <tbody>
            {servicesCatalog.map((row) => (
              <tr>
                <th scope="row" class="font-bold text-[#121519]">{row.name}</th>
                <td data-label="Что делаем" class="text-[#4E5560]">{row.desc}</td>
                <td data-label="Типовой срок" class="whitespace-nowrap text-[#4E5560]">{row.term}</td>
                <td data-label="Ориентир стоимости" class="font-semibold text-[#121519] tabular-nums">{row.price}</td>
                <td data-label="Страница">
                  <a href={row.href} class="font-semibold text-[#9E1B1E] hover:underline no-underline whitespace-nowrap">
                    Подробнее →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-5 flex flex-wrap items-center justify-between gap-4 text-sm">
        <p class="max-w-[68ch] text-[#4E5560]">
          * {siteConfig.prices.note}
        </p>
        <a href="/tseny-i-poshliny/" class="font-semibold text-[#9E1B1E] hover:underline no-underline">
          Смотреть подробный прайс-лист и таблицу пошлин Роспатента 2026 →
        </a>
      </div>
    </div>
  </section>

  <!-- Блок 4: Калькулятор -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <FeeCalculator />
  </div>

  <!-- Блок 5: Модель двойного доверия (Контрастный графитовый блок #121519) -->
  <section aria-labelledby="trust-heading" class="border-y border-[#121519] bg-[#121519] py-14 sm:py-16 text-[#ECEEF2]">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="trust-heading" class="text-3xl font-semibold tracking-tight text-white sm:text-4xl">
            Личная ответственность офиса в СПб и экспертиза патентных поверенных
          </h2>
          <p class="mt-4 max-w-[68ch] text-base leading-relaxed text-[#B8BFC9]">
            Петербургский офис лично отвечает за стратегию, договор и результат вашего дела — от очного разбора задачи
            до представительства в Арбитражном суде СПб и ЛО. К узкопрофильным процедурам в ФИПС, ППС и СИП
            подключаются аттестованные патентные поверенные РФ сети BeBrand.
          </p>
          <p class="mt-3 max-w-[68ch] text-base leading-relaxed text-[#B8BFC9]">
            У сети BeBrand более 50 офисов и более 30 000 клиентов по России.
          </p>

          <ol class="mt-8 space-y-3 border-t border-[#2A3039] pt-6 text-sm text-[#D6DAE2]">
            <li><span class="font-semibold text-[#E5A9AA] tabular-nums">01.</span> Офис в СПб — стратегия защиты, договор, очные встречи и ответственность за результат.</li>
            <li><span class="font-semibold text-[#E5A9AA] tabular-nums">02.</span> Профильные эксперты — аттестованные патентные поверенные РФ под каждый тип актива.</li>
            <li><span class="font-semibold text-[#E5A9AA] tabular-nums">03.</span> Ведомства и суды — официальное электронное делопроизводство с ФИПС, ППС и СИП.</li>
          </ol>
        </div>

        <ol class="divide-y divide-[#2A3039] border-y border-[#2A3039] lg:col-span-7">
          <li class="py-6">
            <h3 class="text-base font-bold text-white">1. Подтверждённый объём регистраций</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-[#B8BFC9]">
              В независимом реестре патентных поверенных IRPA за 2026 год подтверждено 4 103 зарегистрированных
              ООО «БизБренд» товарных знака за год.
            </p>
            <a
              href="https://irpa-rating.com/bizbrand"
              target="_blank"
              rel="noopener noreferrer nofollow"
              class="mt-3 inline-block text-xs font-semibold text-[#E5A9AA] hover:underline"
            >
              Карточка в рейтинге IRPA →
            </a>
          </li>
          <li class="py-6">
            <h3 class="text-base font-bold text-white">2. Профильная специализация патентных поверенных</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-[#B8BFC9]">
              Заявки на товарные знаки, формулы патентов и защиту интересов в Палате по патентным спорам ведут
              аттестованные патентные поверенные РФ с узкой специализацией, а не юристы широкого профиля.
            </p>
          </li>
          <li class="py-6">
            <h3 class="text-base font-bold text-white">3. Прозрачная смета и защита от избыточных расходов</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-[#B8BFC9]">
              Смета фиксируется до подписания договора: отдельно фиксированный гонорар за этап и обязательные пошлины по закону.
              Перечень товаров и услуг выверяется так, чтобы защитить бизнес без искусственного раздувания классов.
            </p>
          </li>
          <li class="py-6">
            <h3 class="text-base font-bold text-white">4. Электронный документооборот с ФИПС и контроль сроков</h3>
            <p class="mt-2 max-w-md text-sm leading-relaxed text-[#B8BFC9]">
              Заявки подаются в электронном виде с фиксацией даты приоритета в день поступления в ведомство;
              собственная система контролирует сроки ответов на запросы экспертизы и уведомлений Роспатента.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Блок 6: Порядок работы -->
  <section aria-labelledby="steps-heading" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="max-w-[68ch]">
      <h2 id="steps-heading" class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
        Как проходит работа: от проверки до свидетельства
      </h2>
      <p class="mt-3 text-base text-[#4E5560]">
        Ниже приведён сквозной график на примере регистрации товарного знака (процедуры по патентам, ПО и договорам
        детализированы на профильных страницах).
      </p>
    </div>

    <div class="mt-8 grid divide-y divide-[#D6DAE2] border border-[#D6DAE2] bg-white md:grid-cols-2 md:divide-y-0 lg:grid-cols-4">
      {steps.map((step, idx) => (
        <article class:list={[
          'flex flex-col justify-between p-6',
          idx > 0 ? 'lg:border-l lg:border-[#D6DAE2]' : '',
          idx % 2 === 1 ? 'md:border-l md:border-[#D6DAE2] lg:border-l' : '',
          idx >= 2 ? 'md:border-t md:border-[#D6DAE2] lg:border-t-0' : '',
        ]}>
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-xs font-bold uppercase tracking-wider text-[#9E1B1E] tabular-nums">Шаг {step.num}</span>
              <span class="text-xs font-medium text-[#4E5560]">{step.term}</span>
            </div>
            <h3 class="mt-3 text-lg font-bold text-[#121519]">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-[#4E5560]">{step.desc}</p>
          </div>
          <div class="mt-6 border-t border-[#D6DAE2] py-3 text-xs leading-relaxed text-[#121519]">
            <span class="block font-semibold text-[#9E1B1E]">Документ на руки:</span>
            <span class="mt-1 block text-[#4E5560]">{step.doc}</span>
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Блок 7: Команда -->
  <div class="border-t border-[#D6DAE2] bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <TeamSection />
    </div>
  </div>

  <!-- Блок 8: FAQ -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <FaqAccordion items={faqItems} openFirst={true} />
  </div>

  <!-- Блок 9: Основная форма заявки -->
  <section id="lead-form-section" aria-labelledby="main-form-heading" class="border-y border-[#D6DAE2] bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="main-form-heading" class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
            Запросить предварительную проверку или консультацию
          </h2>
          <p class="mt-4 text-base leading-relaxed text-[#4E5560]">
            Опишите задачу в двух предложениях или укажите название бренда — специалист офиса в Санкт-Петербурге
            свяжется с вами в рабочее время, оценит базовые риски и подготовит смету с разбивкой пошлин.
          </p>
          <p class="mt-6 border-l-4 border-[#9E1B1E] bg-[#F7F8FA] p-4 text-sm text-[#121519]">
            Без навязчивых обзвонов: посмотрим задачу, назовём реальные сроки и точную сумму государственных пошлин до заключения договора.
          </p>
        </div>
        <div class="border border-[#D6DAE2] bg-[#F7F8FA] p-6 sm:p-8 lg:col-span-7">
          <LeadForm
            formId="main-lead-form"
            goalId="goal_form_main_submit"
            showDirectionSelector={true}
            submitLabel="Отправить запрос"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Блок 10: Контакты и карта -->
  <section aria-labelledby="contacts-home-heading" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid items-start gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="contacts-home-heading" class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl">
          Офис BeBrand в Санкт-Петербурге
        </h2>
        <address class="mt-6 space-y-3.5 text-base not-italic text-[#121519]">
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Адрес</span>
            {siteConfig.contacts.postalCode}, г. {siteConfig.contacts.city}, {siteConfig.contacts.streetAddress}
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Ближайшее метро</span>
            {siteConfig.contacts.metro}
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Телефон</span>
            <a href={`tel:${siteConfig.contacts.phoneHref}`} data-ym-goal="goal_click_phone" class="font-semibold text-[#9E1B1E] hover:underline no-underline tabular-nums">
              {siteConfig.contacts.phoneDisplay}
            </a>
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Электронная почта</span>
            <a href={`mailto:${siteConfig.contacts.email}`} data-ym-goal="goal_click_email" class="text-[#9E1B1E] hover:underline no-underline">
              {siteConfig.contacts.email}
            </a>
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Мессенджеры</span>
            <a href={siteConfig.contacts.telegramUrl} target="_blank" rel="noopener noreferrer" data-ym-goal="goal_click_messenger" class="font-medium text-[#9E1B1E] hover:underline no-underline">
              Telegram офиса СПб
            </a>
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-[#4E5560]">График работы</span>
            {siteConfig.contacts.workingHours}
          </p>
        </address>
        <p class="mt-4 text-sm text-[#4E5560]">
          Принимаем клиентов очно в Санкт-Петербурге и работаем дистанционно по всей Ленинградской области и Северо-Западу.
        </p>
        <a href="/kontakty/" class="mt-4 inline-block text-sm font-semibold text-[#9E1B1E] hover:underline no-underline">
          Схема проезда и реквизиты →
        </a>
      </div>
      <div class="lg:col-span-7">
        <YandexMapLazy />
      </div>
    </div>
  </section>
</BaseLayout>
