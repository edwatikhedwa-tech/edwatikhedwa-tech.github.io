---
import BaseLayout from '../layouts/BaseLayout.astro';
import ScenarioTabs from '../components/ScenarioTabs.astro';
import FeeCalculator from '../components/FeeCalculator.astro';
import TeamSection from '../components/TeamSection.astro';
import FaqAccordion, { type FaqItem } from '../components/FaqAccordion.astro';
import LeadForm from '../components/LeadForm.astro';
import YandexMapLazy from '../components/YandexMapLazy.astro';
import siteConfig from '../data/site-config.json';
import { formatRub } from '../data/calculator';

const faqItems: FaqItem[] = [
  {
    question: 'Нужно ли переводить вывеску и сайт на русский язык по закону 168-ФЗ, если зарегистрировать товарный знак?',
    answer:
      'Нет, на само зарегистрированное обозначение требование перевода не распространяется: ст. 10.1 Закона о защите прав потребителей (вступила в силу 1 марта 2026 года по абз. 8 ст. 1 Закона № 168-ФЗ) прямо выводит зарегистрированные товарные знаки, знаки обслуживания и фирменные наименования юрлиц из-под обязательного перевода. При этом незарегистрированные коммерческие обозначения, сопутствующая потребительская информация (ценники, таблички «Open/Sale», навигация) и названия новых жилых комплексов застройщиков (214-ФЗ) подлежат оформлению на русском языке.',
  },
  {
    question: 'Могут ли физические лица и самозанятые зарегистрировать товарный знак?',
    answer:
      'Да. С 29 июня 2023 года подать заявку и владеть товарным знаком в России вправе не только юридические лица и ИП, но и физические лица, включая самозанятых.',
  },
  {
    question: 'Почему госпошлины на товарный знак у разных компаний сильно отличаются?',
    answer:
      'С 5 октября 2024 года отменена 30-процентная скидка за электронную подачу, а с 4 октября 2025 года по Постановлению Правительства РФ № 1459 введена доплата 500 ₽ за каждое наименование товара или услуги сверх 10 в одном классе МКТУ. Базовые пошлины за 1 класс (до 10 позиций, электронное свидетельство) составляют 35 000 ₽ (17 000 ₽ при подаче и 18 000 ₽ после решения), но при включении 50 позиций в тот же класс сумма возрастает до 55 000 ₽.',
  },
  {
    question: 'Защищает ли уже зарегистрированное название ООО или домен от претензий правообладателя?',
    answer:
      'Не в полной мере. Доменное имя не создаёт исключительного права на бренд, а фирменное наименование доступно только юрлицам (не ИП и самозанятым). Если другая компания зарегистрирует сходный товарный знак в ваших классах МКТУ, она получит право требовать запрета использования вывески, домена и карточек на маркетплейсах, а также компенсации до 10 млн ₽ по ст. 1252.1 ГК РФ.',
  },
  {
    question: 'Чем офис BeBrand в Санкт-Петербурге отличается от дистанционных онлайн-сервисов?',
    answer:
      'Вы сочетаете личное сопровождение в Санкт-Петербурге (очные встречи, разбор документов, выстраивание корпоративных и франчайзинговых схем) с ресурсами федерального юридического центра (Топ-2 рейтинга IRPA 2026) и аттестованными патентными поверенными РФ.',
  },
  {
    question: 'Обеспечивается ли конфиденциальность до подачи патентной заявки?',
    answer:
      'Да. До передачи описаний, чертежей, рецептур или фрагментов исходного кода подписывается соглашение о конфиденциальности (NDA).',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'LegalService',
      name: siteConfig.fullBrandTitle,
      url: `${siteConfig.siteUrl}/`,
      logo: `${siteConfig.siteUrl}/favicon.svg`,
      telephone: siteConfig.contacts.phoneHref,
      email: siteConfig.contacts.email,
      areaServed: [
        { '@type': 'City', name: 'Санкт-Петербург' },
        { '@type': 'AdministrativeArea', name: 'Ленинградская область' },
      ],
      address: {
        '@type': 'PostalAddress',
        addressCountry: 'RU',
        addressRegion: 'Санкт-Петербург',
        addressLocality: siteConfig.contacts.city,
        postalCode: siteConfig.contacts.postalCode,
        streetAddress: siteConfig.contacts.streetAddress,
      },
      openingHours: siteConfig.contacts.openingHoursIso,
      priceRange: '₽₽',
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: {
          '@type': 'Answer',
          text: item.answer,
        },
      })),
    },
  ],
};

const servicesCatalog = [
  {
    name: 'Товарные знаки',
    desc: 'Проверка по базам ФИПС, подбор и оптимизация МКТУ (экономия на пошлинах по ПП № 1459), стандартная и ускоренная регистрация, международная охрана, продление.',
    term: '6–9 мес. (стандарт) / 2–3 мес. (ускоренно)',
    price: `от ${formatRub(siteConfig.prices.trademarkStandard)}`,
    href: '/tovarnye-znaki/',
  },
  {
    name: 'Патентование',
    desc: 'Изобретения (технологии, составы, способы), полезные модели (устройства), промышленные образцы (дизайн изделия, упаковка, интерфейс), патентный поиск и чистота.',
    term: 'Зависит от объекта патентования',
    price: `от ${formatRub(siteConfig.prices.industrialDesign)} (промобразец) / от ${formatRub(siteConfig.prices.utilityModel)} (модель)`,
    href: '/patentovanie/',
  },
  {
    name: 'Программы ЭВМ и Реестр ПО',
    desc: 'Госрегистрация программ для ЭВМ и баз данных в Роспатенте; подготовка юридического и технического пакета для Единого реестра российского ПО Минцифры.',
    term: '2–6 мес. (Роспатент)',
    price: `от ${formatRub(siteConfig.prices.softwareEvm)}`,
    href: '/programmy-evm-i-reestr-po/',
  },
  {
    name: 'Договоры, франшиза и авторское право',
    desc: 'Разработка и регистрация в Роспатенте договоров коммерческой концессии, лицензионных договоров и договоров отчуждения прав; авторские договоры и депонирование.',
    term: '~2 мес. (регистрация в ФИПС)',
    price: `от ${formatRub(siteConfig.prices.franchiseContract)} (концессия) / от ${formatRub(siteConfig.prices.licenseContract)} (лицензия)`,
    href: '/dogovory-i-franshiza/',
  },
  {
    name: 'Защита прав, споры и суды',
    desc: 'Преодоление предварительных отказов Роспатента, снятие контрафакта на WB/Ozon, претензии, ФАС, ППС, Суд по интеллектуальным правам, аннулирование ТЗ.',
    term: 'Досудебная претензия — 30 дней по закону',
    price: `от ${formatRub(siteConfig.prices.annulment)} (аннулирование при ликвидации) / расчёт по делу`,
    href: '/zashchita-i-spory/',
  },
  {
    name: 'Нейминг и доработка знака',
    desc: 'Создание патентоспособных названий и логотипов, доработка обозначения при выявлении сходных знаков в Роспатенте.',
    term: 'По ТЗ',
    price: 'По запросу',
    href: '#lead-form-section',
  },
];

const steps = [
  {
    num: '01',
    title: 'Диагностика задачи и проверка обозначения',
    term: '1–2 рабочих дня',
    desc: 'Проверяем название и логотип по зарегистрированным знакам и поданным заявкам в базах ФИПС, оцениваем основания отказа по ст. 1483 ГК РФ и подбираем классы МКТУ без лишних доплат.',
    doc: 'Письменное заключение о рисках и рекомендации по доработке (при наличии препятствий).',
  },
  {
    num: '02',
    title: 'Договор, фиксация сметы и подача заявки',
    term: 'до 5 рабочих дней',
    desc: 'Фиксируем в договоре объём работ, стоимость и конфиденциальность, готовим квитанции на 1-ю часть госпошлины и подаём заявку в Роспатент электронно.',
    doc: 'Уведомление о поступлении заявки (Форма 940) с закреплённой датой приоритета.',
  },
  {
    num: '03',
    title: 'Формальная экспертиза и экспертиза по существу',
    term: '1–3 мес. и 6–9 мес. (либо 2–3 мес. суммарно при ускорении)',
    desc: 'Сопровождаем делопроизводство, готовим правовые ответы на запросы и предварительные уведомления ФИПС, контролируем процессуальные сроки.',
    doc: 'Уведомления о стадиях и Решение о государственной регистрации.',
  },
  {
    num: '04',
    title: 'Оплата финальной пошлины и получение свидетельства',
    term: 'до 2 месяцев после оплаты',
    desc: 'Формируем платёж на 2-ю часть госпошлины и контролируем внесение записи в Государственный реестр Роспатента.',
    doc: 'Официальное свидетельство о регистрации (электронное с усиленной подписью Роспатента и по желанию бумажный оригинал) и комплект закрывающих документов.',
  },
];
---

<BaseLayout
  title="Патентное бюро BeBrand в СПб — товарные знаки, патенты, защита ИС"
  description="Офис федеральной сети BeBrand в Санкт-Петербурге: регистрация товарных знаков, патенты, Реестр ПО, договоры франшизы и защита в суде. Топ-2 в России (IRPA 2026). Расчёт пошлин 2026."
  canonicalPath="/"
  jsonLd={jsonLd}
>
  <!-- Блок 1: Hero -->
  <section class="border-b border-slate-200 bg-white py-12 sm:py-16 lg:py-20">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid items-start gap-10 lg:grid-cols-12">
        <div class="lg:col-span-7">
          <span class="inline-flex items-center gap-2 rounded-full border border-blue-200 bg-blue-50 px-3.5 py-1 text-xs font-semibold text-blue-800">
            Санкт-Петербург и Ленинградская область
          </span>
          <h1 class="mt-4 text-3xl font-extrabold tracking-tight text-slate-900 sm:text-4xl lg:text-5xl">
            Защита брендов, технологий и интеллектуальных активов в Санкт-Петербурге
          </h1>
          <p class="mt-5 text-lg leading-relaxed text-slate-600">
            Регистрируем товарные знаки, патентуем разработки и дизайн, вносим ПО в Реестр Минцифры, оформляем франшизы
            и защищаем права на маркетплейсах и в суде. Ведём клиентов лично в Санкт-Петербурге, исполняем задачи силами
            федерального юридического центра BeBrand и аттестованных патентных поверенных РФ.
          </p>
          <div class="mt-8 flex flex-wrap items-center gap-4">
            <button
              type="button"
              data-open-check-modal
              command="show-modal"
              commandfor="check-modal"
              class="inline-flex min-h-[48px] items-center justify-center rounded-lg bg-blue-700 px-6 py-3 text-base font-semibold text-white shadow-xs transition-colors hover:bg-blue-800 cursor-pointer"
            >
              Проверить знак или задачу
            </button>
            <a
              href="#calculator"
              class="inline-flex min-h-[48px] items-center justify-center rounded-lg border border-slate-300 bg-white px-5 py-3 text-base font-semibold text-slate-800 transition-colors hover:bg-slate-50 no-underline"
            >
              Рассчитать пошлины 2026 ↓
            </a>
          </div>
        </div>

        <!-- Правый документальный модуль (AST-02 fallback) -->
        <aside class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-7 lg:col-span-5" aria-label="Подтверждённые показатели">
          <p class="text-xs font-semibold uppercase tracking-wider text-slate-500">
            Подтверждённые факты и квалификация
          </p>
          <dl class="mt-5 space-y-5">
            <div class="border-b border-slate-200 pb-4">
              <dt class="text-2xl font-extrabold text-blue-700 tabular-nums">Топ-2 в России</dt>
              <dd class="mt-1 text-sm text-slate-700">
                По числу зарегистрированных товарных знаков (4 103 свидетельства, доля 5,77%, рейтинг IRPA 2026).
              </dd>
            </div>
            <div class="border-b border-slate-200 pb-4">
              <dt class="text-2xl font-extrabold text-slate-900 tabular-nums">С 2013 года</dt>
              <dd class="mt-1 text-sm text-slate-700">
                Федеральная сеть из более чем 50 представительств и свыше 30 000 клиентов по данным BeBrand.
              </dd>
            </div>
            <div>
              <dt class="text-lg font-bold text-slate-900">Аттестованные поверенные РФ</dt>
              <dd class="mt-1 text-sm text-slate-700">
                Профильные руководители практик по товарным знакам, патентам и судам (№ 2149, № 2150, № 2314).
              </dd>
            </div>
          </dl>
        </aside>
      </div>
    </div>
  </section>

  <!-- Блок 2: Маршрутизатор сценариев -->
  <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
    <ScenarioTabs />
  </div>

  <!-- Блок 3: Реестр услуг -->
  <section aria-labelledby="catalog-heading" class="bg-white py-14 sm:py-16 border-y border-slate-200">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="max-w-3xl">
        <h2 id="catalog-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Направления практики и услуги
        </h2>
        <p class="mt-3 text-base text-slate-600">
          Сопровождаем весь цикл работы с нематериальными активами: от проверки чистоты идеи до защиты исключительных прав
          в Палате по патентным спорам и судах.
        </p>
      </div>

      <div tabindex="0" role="region" aria-labelledby="catalog-heading" class="table-wrapper mt-8">
        <table class="data-table data-table--stack">
          <thead>
            <tr>
              <th>Направление</th>
              <th>Что делаем</th>
              <th>Типовой срок</th>
              <th>Ориентир услуг бюро (без пошлин)*</th>
              <th>Переход</th>
            </tr>
          </thead>
          <tbody>
            {servicesCatalog.map((row) => (
              <tr>
                <th scope="row" class="font-bold text-slate-900">{row.name}</th>
                <td data-label="Что делаем" class="text-slate-700">{row.desc}</td>
                <td data-label="Типовой срок" class="whitespace-nowrap text-slate-700">{row.term}</td>
                <td data-label="Ориентир стоимости" class="font-semibold text-slate-900 tabular-nums">{row.price}</td>
                <td data-label="Страница">
                  <a href={row.href} class="font-semibold text-blue-700 hover:underline no-underline whitespace-nowrap">
                    Подробнее →
                  </a>
                </td>
              </tr>
            ))}
          </tbody>
        </table>
      </div>

      <div class="mt-4 flex flex-wrap items-center justify-between gap-4 text-sm">
        <p class="text-slate-500">
          * Указаны федеральные ориентиры стоимости услуг BeBrand; финальный прайс офиса СПб утверждается до публикации.
        </p>
        <a href="/tseny-i-poshliny/" class="font-semibold text-blue-700 hover:underline no-underline">
          Смотреть подробный прайс-лист и таблицу пошлин Роспатента 2026 →
        </a>
      </div>
    </div>
  </section>

  <!-- Блок 4: Калькулятор -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <FeeCalculator />
  </div>

  <!-- Блок 5: Модель двойного доверия -->
  <section aria-labelledby="trust-heading" class="border-y border-slate-200 bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="trust-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Локальная ответственность в Санкт-Петербурге и ресурсы федерального патентного центра
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Вы общаетесь лично с руководителем и специалистами офиса в Санкт-Петербурге, а правовую экспертизу,
            подачу заявок и ведение дел в Роспатенте выполняют профильные департаменты и аттестованные патентные
            поверенные федерального центра BeBrand.
          </p>

          <div class="mt-6 rounded-xl border border-slate-200 bg-slate-50 p-5 text-sm">
            <p class="font-semibold text-slate-900">Схема взаимодействия</p>
            <ol class="mt-3 space-y-2 text-slate-700">
              <li>1. Офис в СПб — личная диагностика, договор, контроль сроков.</li>
              <li>2. Федеральный центр — профильные эксперты и патентные поверенные РФ.</li>
              <li>3. Роспатент / ППС / Суды — электронная подача и защита прав.</li>
            </ol>
          </div>
        </div>

        <ol class="space-y-4 lg:col-span-7">
          <li class="rounded-xl border border-slate-200 p-5">
            <h3 class="text-base font-bold text-slate-900">1. Проверенный объём завершённых регистраций</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              По данным независимого рейтинга IRPA за 2026 год ООО «БизБренд» занимает 2-е место в России с 4 103
              зарегистрированными товарными знаками (5,77% коммерческого сегмента). В официальных рейтингах Роспатента
              за 2020–I пол. 2022 года компания удерживала 1-е место по электронной подаче заявок на товарные знаки.
            </p>
          </li>
          <li class="rounded-xl border border-slate-200 p-5">
            <h3 class="text-base font-bold text-slate-900">2. Узкая специализация патентных поверенных под вид объекта</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Заявки на товарные знаки, патентные формулы и судебные споры ведут разные профильные подразделения под
              руководством аттестованных патентных поверенных РФ (№ 2149, № 2150, № 2314), а не юристы широкого профиля.
            </p>
          </li>
          <li class="rounded-xl border border-slate-200 p-5">
            <h3 class="text-base font-bold text-slate-900">3. Оптимизация пошлин и прозрачная смета до договора</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Мы отдельно показываем гонорар бюро и государственные пошлины до подписания договора. Перечень товаров и
              услуг редактируется так, чтобы защитить реальный бизнес и не переплачивать по 500 ₽ за ненужные позиции МКТУ сверх 10.
            </p>
          </li>
          <li class="rounded-xl border border-slate-200 p-5">
            <h3 class="text-base font-bold text-slate-900">4. Электронный документооборот с ФИПС и контроль сроков</h3>
            <p class="mt-1.5 text-sm leading-relaxed text-slate-600">
              Заявки подаются в электронном виде с фиксацией даты приоритета в день поступления в ведомство; по данным
              компании, собственная IT-система контролирует сроки ответов на запросы экспертизы и уведомлений Роспатента.
            </p>
          </li>
        </ol>
      </div>
    </div>
  </section>

  <!-- Блок 6: Порядок работы -->
  <section aria-labelledby="steps-heading" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="max-w-3xl">
      <h2 id="steps-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
        Как проходит работа: от проверки до свидетельства
      </h2>
      <p class="mt-3 text-base text-slate-600">
        Ниже приведён сквозной график на примере регистрации товарного знака (процедуры по патентам, ПО и договорам
        детализированы на профильных страницах).
      </p>
    </div>

    <div class="mt-8 grid gap-5 md:grid-cols-2 lg:grid-cols-4">
      {steps.map((step) => (
        <article class="flex flex-col justify-between rounded-2xl border border-slate-200 bg-white p-6">
          <div>
            <div class="flex items-center justify-between gap-2">
              <span class="text-sm font-extrabold text-blue-700 tabular-nums">Шаг {step.num}</span>
              <span class="text-xs font-medium text-slate-500">{step.term}</span>
            </div>
            <h3 class="mt-3 text-lg font-bold text-slate-900">{step.title}</h3>
            <p class="mt-2 text-sm leading-relaxed text-slate-600">{step.desc}</p>
          </div>
          <div class="mt-5 rounded-lg bg-slate-50 p-3.5 text-xs leading-relaxed text-slate-700 border border-slate-200">
            <span class="block font-semibold text-slate-900">Документ на руки:</span>
            {step.doc}
          </div>
        </article>
      ))}
    </div>
  </section>

  <!-- Блок 7: Команда -->
  <div class="border-t border-slate-200 bg-white">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <TeamSection />
    </div>
  </div>

  <!-- Блок 8: FAQ -->
  <div class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <FaqAccordion items={faqItems} openFirst={true} />
  </div>

  <!-- Блок 9: Основная форма заявки -->
  <section id="lead-form-section" aria-labelledby="main-form-heading" class="border-y border-slate-200 bg-white py-14 sm:py-16">
    <div class="mx-auto max-w-7xl px-4 sm:px-6 lg:px-8">
      <div class="grid gap-10 lg:grid-cols-12">
        <div class="lg:col-span-5">
          <h2 id="main-form-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
            Запросить предварительную проверку или консультацию
          </h2>
          <p class="mt-4 text-base leading-relaxed text-slate-600">
            Опишите задачу в двух предложениях или укажите название бренда — специалист офиса в Санкт-Петербурге
            свяжется с вами в рабочее время, оценит базовые риски и подготовит смету с разбивкой пошлин.
          </p>
          <p class="mt-4 rounded-xl bg-slate-50 p-4 text-sm text-slate-700 border border-slate-200">
            Без навязчивых обзвонов: посмотрим задачу, назовём реальные сроки и точную сумму государственных пошлин до заключения договора.
          </p>
        </div>
        <div class="rounded-2xl border border-slate-200 bg-slate-50 p-6 sm:p-8 lg:col-span-7">
          <LeadForm
            formId="main-lead-form"
            goalId="goal_form_main_submit"
            showDirectionSelector={true}
            submitLabel="Отправить запрос"
          />
        </div>
      </div>
    </div>
  </section>

  <!-- Блок 10: Контакты и карта -->
  <section aria-labelledby="contacts-home-heading" class="mx-auto max-w-7xl px-4 py-14 sm:px-6 sm:py-16 lg:px-8">
    <div class="grid items-start gap-8 lg:grid-cols-12">
      <div class="lg:col-span-5">
        <h2 id="contacts-home-heading" class="text-2xl font-bold tracking-tight text-slate-900 sm:text-3xl">
          Офис BeBrand в Санкт-Петербурге
        </h2>
        <address class="mt-5 space-y-3 text-base not-italic text-slate-700">
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Адрес</span>
            {siteConfig.contacts.postalCode}, г. {siteConfig.contacts.city}, {siteConfig.contacts.streetAddress}
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Ближайшее метро</span>
            {siteConfig.contacts.metro}
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Телефон</span>
            <a href={`tel:${siteConfig.contacts.phoneHref}`} data-ym-goal="goal_click_phone" class="font-semibold text-blue-700 hover:underline no-underline tabular-nums">
              {siteConfig.contacts.phoneDisplay}
            </a>
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Электронная почта</span>
            <a href={`mailto:${siteConfig.contacts.email}`} data-ym-goal="goal_click_email" class="text-blue-700 hover:underline no-underline">
              {siteConfig.contacts.email}
            </a>
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">Мессенджеры</span>
            <a href={siteConfig.contacts.telegramUrl} target="_blank" rel="noopener noreferrer" data-ym-goal="goal_click_messenger" class="font-medium text-blue-700 hover:underline no-underline">
              Telegram офиса СПб
            </a>
          </p>
          <p>
            <span class="block text-xs font-semibold uppercase tracking-wider text-slate-500">График работы</span>
            {siteConfig.contacts.workingHours}
          </p>
        </address>
        <p class="mt-4 text-sm text-slate-600">
          Принимаем клиентов очно в Санкт-Петербурге и работаем дистанционно по всей Ленинградской области и Северо-Западу.
        </p>
        <a href="/kontakty/" class="mt-4 inline-block text-sm font-semibold text-blue-700 hover:underline no-underline">
          Схема проезда и реквизиты →
        </a>
      </div>
      <div class="lg:col-span-7">
        <YandexMapLazy />
      </div>
    </div>
  </section>
</BaseLayout>
