---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import TeamSection from '../../components/TeamSection.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import LeadForm from '../../components/LeadForm.astro';
import siteConfig from '../../data/site-config.json';

const faqItems: FaqItem[] = [
  {
    question: 'С кем именно заключается договор при обращении в петербургский офис?',
    answer: siteConfig.legal.contractModel,
  },
  {
    question: 'Как проверить квалификацию патентных поверенных?',
    answer:
      'Квалификация каждого профильного патентного поверенного РФ подтверждается по фамилии и специализации в официальном Реестре патентных поверенных на сайте Роспатента.',
  },
  {
    question: 'Работаете ли вы с компаниями из Ленинградской области и СЗФО?',
    answer:
      'Да. Вся переписка с Роспатентом ведётся электронно, поэтому мы принимаем клиентов как очно в офисе в Санкт-Петербурге, так и дистанционно с обменом документами через ЭДО.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${siteConfig.siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'О компании', item: `${siteConfig.siteUrl}/o-kompanii/` },
      ],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="Об офисе BeBrand в Санкт-Петербурге — ответственность и команда поверенных"
  description="Представительство федеральной сети BeBrand в Санкт-Петербурге: личная ответственность офиса за стратегию и результат, 4 103 зарегистрированных товарных знака за год (IRPA 2026), аттестованные патентные поверенные."
  canonicalPath="/o-kompanii/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'О компании' }]} />

    <section class="max-w-xl">
      <h1 class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl lg:text-5xl">
        Офис BeBrand в Санкт-Петербурге и практика защиты ИС
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4E5560]">
        Петербургский офис лично отвечает за стратегию, договор и результат клиента в Санкт-Петербурге и Ленинградской
        области. Для узкоспециализированных процедур в Роспатенте, ППС и СИП к работе подключаются аттестованные
        патентные поверенные РФ федеральной сети BeBrand (работающей с 2013 года).
      </p>
    </section>

    <section class="mt-12 grid divide-y divide-[#D6DAE2] border border-[#D6DAE2] bg-white md:grid-cols-3 md:divide-y-0 md:divide-x">
      <article class="p-6 sm:p-8">
        <p class="font-display text-3xl font-semibold text-[#9E1B1E] tabular-nums">4 103 знака</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Реестр IRPA 2026</p>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
          Зарегистрированных товарных знаков за год по данным независимого реестра IRPA 2026. Атрибуция к патентному бюро рассчитывается составителями реестра по открытым данным и может носить приближённый характер.
        </p>
        <div class="mt-4 flex flex-wrap gap-x-4 gap-y-2 text-xs font-semibold">
          <a
            href="https://irpa-rating.com/bizbrand"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="text-[#9E1B1E] hover:underline"
          >
            Карточка в реестре IRPA →
          </a>
          <a
            href="https://irpa-rating.com/metodology"
            target="_blank"
            rel="noopener noreferrer nofollow"
            class="text-[#4E5560] hover:underline"
          >
            Методология расчёта IRPA →
          </a>
        </div>
      </article>

      <article class="p-6 sm:p-8">
        <p class="font-display text-3xl font-semibold text-[#121519]">Офис в СПб и суды СЗФО</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Личное представительство</p>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
          Очные консультации в Петербурге, аудит рисков до подачи заявки и личное представительство в Арбитражном суде СПб и ЛО и УФАС.
        </p>
      </article>

      <article class="p-6 sm:p-8">
        <p class="font-display text-3xl font-semibold text-[#121519]">IT-контроль сроков</p>
        <p class="mt-1 text-xs font-semibold uppercase tracking-wider text-[#4E5560]">Электронный документооборот</p>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
          По данным BeBrand, собственная IT-система делопроизводства автоматически отслеживает процессуальные сроки и
          уведомления ФИПС, снижая риск технических ошибок.
        </p>
      </article>
    </section>

    <div class="mt-8">
      <TeamSection />
    </div>

    <section class="mt-8 grid border border-[#D6DAE2] bg-white md:grid-cols-2">
      <div class="p-6 sm:p-8">
        <h2 class="text-xl font-bold text-[#121519]">Стандарты работы и конфиденциальность</h2>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
          Работа опирается на три принципа: честная предварительная оценка рисков (не подаём заведомо отказные заявки ради
          комиссии), разделение гонорара и госпошлин до подписания договора, строгий режим конфиденциальности (NDA) —
          чувствительные технологические и корпоративные проекты не публикуются без письменного разрешения клиента.
        </p>
      </div>
      <div class="border-t border-[#D6DAE2] p-6 sm:p-8 md:border-t-0 md:border-l">
        <h2 class="text-xl font-bold text-[#121519]">Юридические сведения</h2>
        <dl class="mt-3 space-y-2 text-sm text-[#4E5560]">
          <div><dt class="inline font-semibold text-[#121519]">Организация:</dt> <dd class="inline">{siteConfig.legal.entityName}</dd></div>
          <div><dt class="inline font-semibold text-[#121519]">ИНН:</dt> <dd class="inline tabular-nums">{siteConfig.legal.inn}</dd></div>
          <div><dt class="inline font-semibold text-[#121519]">ОГРН:</dt> <dd class="inline tabular-nums">{siteConfig.legal.ogrn}</dd></div>
          <div><dt class="inline font-semibold text-[#121519]">Адрес:</dt> <dd class="inline">{siteConfig.legal.legalAddress}</dd></div>
        </dl>
        <a href="/kontakty/" class="mt-4 inline-block text-sm font-semibold text-[#9E1B1E] hover:underline">
          Контакты и реквизиты →
        </a>
      </div>
    </section>

    <div class="mt-12">
      <FaqAccordion items={faqItems} />
    </div>

    <section class="mt-12 border border-[#D6DAE2] bg-white p-6 sm:p-8">
      <LeadForm
        formId="about-lead-form"
        goalId="goal_form_contacts_submit"
        title="Записаться на консультацию в офисе или онлайн"
        showMeetingFormat={true}
        submitLabel="Записаться на консультацию"
      />
    </section>
  </div>
</BaseLayout>
