---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import LeadForm from '../../components/LeadForm.astro';
import siteConfig from '../../data/site-config.json';
import { formatRub } from '../../data/calculator';

const faqItems: FaqItem[] = [
  {
    question: 'Сколько составляет госпошлина за регистрацию программы для ЭВМ в 2026 году?',
    answer:
      '5 000 рублей. По ст. 333.30 НК РФ (в ред. Закона № 389-ФЗ) установлен единый размер государственной пошлины как для юридических, так и для физических лиц.',
  },
  {
    question: 'Можно ли зарегистрировать программу, которая уже продаётся клиентам?',
    answer:
      'Да, закон допускает государственную регистрацию программы для ЭВМ в любой момент в течение срока действия исключительного права, в том числе после коммерческого запуска.',
  },
  {
    question: 'Нужно ли регистрировать в Роспатенте договор отчуждения уже зарегистрированной программы?',
    answer:
      'Да, переход исключительного права по договору об отчуждении на зарегистрированную программу для ЭВМ или БД подлежит госрегистрации в Роспатенте; пошлина составляет 5 000 ₽ + 2 500 ₽ за каждый дополнительный объект в договоре.',
  },
  {
    question: 'Подходит ли программно-аппаратный комплекс (ПАК) для Реестра Минцифры?',
    answer:
      'Да, регистрация ПАК в Реестре российского ПО позволяет применять освобождение от НДС (пп. 26 п. 2 ст. 149 НК РФ) и учитывать профильную выручку для IT-льгот.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${siteConfig.siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Программы ЭВМ и Реестр ПО', item: `${siteConfig.siteUrl}/programmy-evm-i-reestr-po/` },
      ],
    },
    {
      '@type': 'Service',
      serviceType: 'Регистрация программ для ЭВМ и включение в Реестр российского ПО',
      provider: { '@type': 'LegalService', name: siteConfig.fullBrandTitle, url: `${siteConfig.siteUrl}/` },
      areaServed: ['Санкт-Петербург', 'Ленинградская область'],
      offers: {
        '@type': 'Offer',
        priceCurrency: 'RUB',
        price: siteConfig.prices.softwareEvm,
        description: 'Стоимость услуг без учёта государственной пошлины 5 000 ₽',
      },
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="Регистрация программ для ЭВМ и внесение в Реестр российского ПО в СПб | BeBrand"
  description="Государственная регистрация программ для ЭВМ и баз данных в Роспатенте (пошлина 5 000 ₽) и сопровождение включения в Единый реестр ПО Минцифры для IT-компаний Санкт-Петербурга."
  canonicalPath="/programmy-evm-i-reestr-po/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Программы ЭВМ и Реестр ПО' }]} />

    <section class="max-w-4xl">
      <h1 class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl lg:text-5xl">
        Регистрация программ для ЭВМ, баз данных и включение в Реестр российского ПО
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4E5560]">
        Помогаем IT-компаниям и разработчикам Санкт-Петербурга оформить исключительные права на программные продукты и
        базы данных в Роспатенте и подготовить юридический и технический пакет для включения в Единый реестр российского ПО Минцифры.
      </p>
      <a href="#software-form" class="mt-6 inline-flex min-h-[48px] items-center rounded-sm bg-[#9E1B1E] px-6 py-3 text-sm font-semibold text-white hover:bg-[#7E1417] no-underline">
        Оценить готовность ПО к регистрации
      </a>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-900">Роспатент или Реестр Минцифры: сравнение двух процедур</h2>
      <div tabindex="0" role="region" aria-label="Сравнение регистрации в Роспатенте и Реестре Минцифры" class="table-wrapper mt-5">
        <table class="data-table data-table--stack">
          <thead>
            <tr>
              <th>Параметр</th>
              <th>Регистрация ЭВМ / БД в Роспатенте</th>
              <th>Включение в Единый реестр российского ПО (Минцифры)</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Зачем нужно</th>
              <td data-label="Роспатент">Фиксация правообладателя и состава продукта, постановка на баланс (НМА), защита в спорах с подрядчиками и при копировании кода.</td>
              <td data-label="Минцифры">Освобождение реализации ПО (в том числе в составе ПАК) от НДС по пп. 26 п. 2 ст. 149 НК РФ; поддержка льготного режима аккредитованных IT-компаний (налог на прибыль 5%, пониженные страховые взносы).</td>
            </tr>
            <tr>
              <th scope="row">Госпошлина (2026)</th>
              <td data-label="Роспатент" class="font-semibold tabular-nums">5 000 ₽ — единая ставка для организаций и физлиц (ст. 333.30 НК РФ)</td>
              <td data-label="Минцифры">Государственная пошлина не взимается</td>
            </tr>
            <tr>
              <th scope="row">Срок</th>
              <td data-label="Роспатент">В среднем 2–6 месяцев</td>
              <td data-label="Минцифры">Индивидуально (подготовка документации и экспертиза Минцифры)</td>
            </tr>
            <tr>
              <th scope="row">Ориентир услуг бюро</th>
              <td data-label="Роспатент" class="font-semibold tabular-nums">от {formatRub(siteConfig.prices.softwareEvm)}</td>
              <td data-label="Минцифры" class="font-semibold">По составу документации</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12 grid border border-[#D6DAE2] bg-white md:grid-cols-2">
      <div class="p-6 sm:p-8">
        <h2 class="text-xl font-bold text-[#121519]">Состав работ</h2>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
          В контуре Роспатента проводим аудит цепочки прав (трудовые договоры, служебные задания, договоры авторского заказа),
          готовим заявление, реферат, депонируемые фрагменты исходного кода и согласия авторов. В контуре Минцифры проверяем
          структуру владения, совместимость стека, готовим эксплуатационную документацию и проверяем обязательное раскрытие
          стоимости ПО на сайте правообладателя.
        </p>
      </div>
      <div class="border-t border-[#D6DAE2] p-6 sm:p-8 md:border-t-0 md:border-l">
        <h2 class="text-xl font-bold text-[#121519]">Типовые причины отказов и налоговые нюансы 2026</h2>
        <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
          Частые причины срыва — неоформленный переход исключительных прав от фрилансеров и штатных разработчиков,
          несоответствие документации требованиям экспертного совета Минцифры и налоговые риски при доработке чужих
          продуктов (по позиции Минфина РФ освобождение от НДС не распространяется на подрядную доработку чужого ПО без
          реализации прав на собственный продукт из реестра).
        </p>
      </div>
    </section>

    <div class="mt-12">
      <FaqAccordion items={faqItems} />
    </div>

    <section id="software-form" class="mt-12 border border-[#D6DAE2] bg-white p-6 sm:p-8">
      <LeadForm
        formId="software-lead-form"
        goalId="goal_form_software_submit"
        title="Запросить аудит ПО для Роспатента или Минцифры"
        submitLabel="Запросить аудит ПО"
        taskLabel="Название продукта, стек и цель (Роспатент / Реестр Минцифры)"
      />
      <hr class="my-6 border-[#D6DAE2]" />
      <div class="flex flex-wrap gap-4 text-sm">
        <a href="/dogovory-i-franshiza/" class="font-semibold text-[#9E1B1E] hover:underline">Договоры с разработчиками →</a>
        <a href="/tovarnye-znaki/" class="font-semibold text-[#9E1B1E] hover:underline">Товарный знак для IT-сервиса →</a>
        <a href="/patentovanie/" class="font-semibold text-[#9E1B1E] hover:underline">Патентование интерфейса и ПАК →</a>
        <a href="/tseny-i-poshliny/" class="font-semibold text-[#9E1B1E] hover:underline">Цены и пошлины →</a>
      </div>
    </section>
  </div>
</BaseLayout>
