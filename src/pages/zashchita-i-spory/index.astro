---
import BaseLayout from '../../layouts/BaseLayout.astro';
import Breadcrumbs from '../../components/Breadcrumbs.astro';
import FaqAccordion, { type FaqItem } from '../../components/FaqAccordion.astro';
import LeadForm from '../../components/LeadForm.astro';
import siteConfig from '../../data/site-config.json';
import { formatRub } from '../../data/calculator';

const faqItems: FaqItem[] = [
  {
    question: 'Обязательно ли отправлять претензию перед подачей иска в суд?',
    answer:
      'Да. Если обе стороны спора о компенсации являются организациями или ИП, досудебный претензионный порядок обязателен по п. 5.1 ст. 1252 ГК РФ; обратиться в суд можно спустя 30 дней после отправки претензии.',
  },
  {
    question: 'Реально ли взыскать максимальную компенсацию 10 млн ₽?',
    answer:
      'Потолок твёрдой компенсации 10 млн ₽ действует с 4 января 2026 года (ст. 1252.1 ГК РФ), однако конкретную сумму суд определяет исходя из характера и доказанного объёма нарушения. Качество фиксации продаж нарушителя напрямую влияет на размер взыскания.',
  },
  {
    question: 'Можно ли заблокировать конкурента на Wildberries или Ozon, если товарный знак ещё на регистрации?',
    answer:
      'Для подачи жалобы по товарному знаку маркетплейсы требуют действующее свидетельство о государственной регистрации (номер регистрации права), а не поданную заявку. До получения свидетельства на знак защита карточек возможна по авторскому праву (на фотографии и описания) или по патенту на промышленный образец.',
  },
  {
    question: 'Как аннулировать чужой товарный знак, если компания-правообладатель ликвидирована?',
    answer:
      'Досрочное прекращение охраны в связи с прекращением деятельности юридического лица проводится в административном порядке через Роспатент, без длительного процесса в Суде по интеллектуальным правам.',
  },
];

const jsonLd = {
  '@context': 'https://schema.org',
  '@graph': [
    {
      '@type': 'BreadcrumbList',
      itemListElement: [
        { '@type': 'ListItem', position: 1, name: 'Главная', item: `${siteConfig.siteUrl}/` },
        { '@type': 'ListItem', position: 2, name: 'Защита и споры', item: `${siteConfig.siteUrl}/zashchita-i-spory/` },
      ],
    },
    {
      '@type': 'Service',
      serviceType: 'Защита интеллектуальных прав, суды, ППС, ФАС и маркетплейсы',
      provider: { '@type': 'LegalService', name: siteConfig.fullBrandTitle, url: `${siteConfig.siteUrl}/` },
      areaServed: ['Санкт-Петербург', 'Ленинградская область'],
    },
    {
      '@type': 'FAQPage',
      mainEntity: faqItems.map((item) => ({
        '@type': 'Question',
        name: item.question,
        acceptedAnswer: { '@type': 'Answer', text: item.answer },
      })),
    },
  ],
};
---

<BaseLayout
  title="Защита интеллектуальных прав в СПб: суды, ППС, ФАС, маркетплейсы | BeBrand"
  description="Досудебная и судебная защита брендов, патентов и авторских прав в Санкт-Петербурге: противодействие контрафакту на маркетплейсах, претензии, споры в Роспатенте (ППС), СИП и арбитражных судах."
  canonicalPath="/zashchita-i-spory/"
  jsonLd={jsonLd}
>
  <div class="mx-auto max-w-7xl px-4 py-10 sm:px-6 lg:px-8">
    <Breadcrumbs items={[{ label: 'Защита и споры' }]} />

    <section class="max-w-4xl">
      <h1 class="text-3xl font-semibold tracking-tight text-[#121519] sm:text-4xl lg:text-5xl">
        Защита интеллектуальных прав: маркетплейсы, претензии, ППС и суды
      </h1>
      <p class="mt-4 text-lg leading-relaxed text-[#4E5560]">
        Представляем интересы правообладателей и защищаем бизнес от необоснованных претензий. Сопровождаем споры на
        маркетплейсах, дела о недобросовестной конкуренции в ФАС, оспаривание решений Роспатента в Палате по патентным
        спорам, арбитражных судах Санкт-Петербурга и Суде по интеллектуальным правам.
      </p>
      <a href="#dispute-form" class="mt-6 inline-flex min-h-[48px] items-center rounded-sm bg-[#9E1B1E] px-6 py-3 text-sm font-semibold text-white hover:bg-[#7E1417] no-underline">
        Разобрать ситуацию с юристом
      </a>
    </section>

    <section class="mt-12">
      <h2 class="text-2xl font-bold text-slate-900">Основные категории споров и правовые инструменты 2026 года</h2>
      <div tabindex="0" role="region" aria-label="Категории споров и правовые нормы 2026" class="table-wrapper mt-5">
        <table class="data-table data-table--stack">
          <thead>
            <tr>
              <th>Ситуация клиента</th>
              <th>Правовой механизм и наши действия</th>
              <th>Ключевые нормы и пошлины 2026 года</th>
            </tr>
          </thead>
          <tbody>
            <tr>
              <th scope="row">Контрафакт и клоны на Wildberries, Ozon, Яндекс Маркете</th>
              <td data-label="Действия">Фиксация карточек нарушителей, контрольная закупка, направление мотивированных претензий продавцу и жалоб через процедуры площадок («Цифровой арбитраж» WB, поддержка Ozon), при необходимости — судебный иск с обеспечительными мерами.</td>
              <td data-label="Нормы">Ст. 1252, 1253.1 и 1515 ГК РФ, правила и регламенты маркетплейсов по рассмотрению обращений правообладателей.</td>
            </tr>
            <tr>
              <th scope="row">Копирование вывески, домена, упаковки или товара</th>
              <td data-label="Действия">Нотариальная фиксация доказательств, обязательная досудебная претензия (30 дней для юрлиц/ИП), обращение в ФАС, иск в арбитражный суд или суд общей юрисдикции.</td>
              <td data-label="Нормы">Ст. 1252.1 и 1515 ГК РФ (214-ФЗ с 04.01.2026): твёрдая компенсация 10 000 – 10 млн ₽ (для патентов 50 000 – 10 млн ₽), либо 2× стоимости контрафакта/лицензии.</td>
            </tr>
            <tr>
              <th scope="row">Поступила претензия или иск от правообладателя</th>
              <td data-label="Действия">Аудит сходства и однородности, проверка знака истца на неиспользование, выработка позиции по снижению компенсации (при нарушении без осведомлённости суд вправе снизить сумму до 10–500 тыс. ₽).</td>
              <td data-label="Нормы">Ст. 1252.1 ГК РФ, ст. 1486 ГК РФ.</td>
            </tr>
            <tr>
              <th scope="row">Предварительный отказ Роспатента или оспаривание решения</th>
              <td data-label="Действия">Мотивированный ответ на уведомление экспертизы, письма-согласия, возражение в Палату по патентным спорам (ППС) и обжалование в СИП.</td>
              <td data-label="Нормы">Пошлины ППС: возражение на решение экспертизы ТЗ — 9 000 ₽ (п. 2.28.2); против предоставления охраны ТЗ — 14 000 ₽ (п. 2.28.4).</td>
            </tr>
            <tr>
              <th scope="row">Мешает чужой «спящий» товарный знак</th>
              <td data-label="Действия">Проверка использования знака, досудебное предложение, иск о досрочном прекращении в СИП или административное аннулирование при ликвидации юрлица-правообладателя.</td>
              <td data-label="Нормы">Аннулирование на основании прекращения деятельности юрлица — ориентир от {formatRub(siteConfig.prices.annulment)}.</td>
            </tr>
          </tbody>
        </table>
      </div>
    </section>

    <section class="mt-12 border border-[#D6DAE2] bg-white p-6 sm:p-8">
      <h2 class="text-2xl font-semibold text-[#121519] sm:text-3xl">Порядок действий при спорах на маркетплейсах</h2>
      <p class="mt-3 text-sm leading-relaxed text-[#4E5560]">
        Защита прав на торговых площадках требует подтверждённого свидетельства на товарный знак или патент, а также
        корректного сбора доказательств. Необоснованная жалоба может повлечь встречные претензии о возмещении убытков,
        поэтому досудебная и судебная работа выстраивается последовательно:
      </p>
      <hr class="my-6 border-[#D6DAE2]" />
      <ol class="grid divide-y divide-[#D6DAE2] sm:grid-cols-2 sm:divide-y-0 lg:grid-cols-5 text-sm">
        <li class="py-4 lg:pr-4"><strong class="block text-[#9E1B1E] mb-1">1. Фиксация</strong>Ссылки, артикулы, скриншоты с датой и временем, реквизиты продавца, при необходимости — нотариальный протокол.</li>
        <li class="py-4 lg:border-l lg:border-[#D6DAE2] lg:px-4"><strong class="block text-[#9E1B1E] mb-1">2. Закупка</strong>Контрольная закупка с сохранением чеков, фото упаковки и сопоставлением с оригинальным товаром.</li>
        <li class="py-4 lg:border-l lg:border-[#D6DAE2] lg:px-4"><strong class="block text-[#9E1B1E] mb-1">3. Жалоба</strong>Направление мотивированного обращения в службу поддержки площадки или через интерфейс споров («Цифровой арбитраж»).</li>
        <li class="py-4 lg:border-l lg:border-[#D6DAE2] lg:px-4"><strong class="block text-[#9E1B1E] mb-1">4. Претензия</strong>Обязательный досудебный порядок (п. 5.1 ст. 1252 ГК РФ) — ожидание ответа на претензию до 30 дней.</li>
        <li class="py-4 lg:border-l lg:border-[#D6DAE2] lg:pl-4"><strong class="block text-[#9E1B1E] mb-1">5. Суд</strong>Подача иска о прекращении нарушения, изъятии контрафакта и взыскании установленной судом компенсации.</li>
      </ol>
    </section>

    <section class="mt-12 border border-[#D6DAE2] bg-white p-6 sm:p-8">
      <h2 class="text-xl font-bold text-[#121519]">Руководитель судебной практики</h2>
      <p class="mt-2 text-base text-[#4E5560]">
        <strong class="text-[#121519]">Анна Кузнецова</strong> — Патентный поверенный РФ № 2314, руководитель подразделения судебной практики BeBrand.
      </p>
    </section>

    <div class="mt-12">
      <FaqAccordion items={faqItems} />
    </div>

    <section id="dispute-form" class="mt-12 border border-[#D6DAE2] bg-white p-6 sm:p-8">
      <LeadForm
        formId="dispute-lead-form"
        goalId="goal_form_dispute_submit"
        title="Отправить ситуацию на правовой разбор"
        showDirectionSelector={true}
        directions={['Нарушают мои права', 'Мне пришла претензия', 'Отказ Роспатента']}
        submitLabel="Разобрать ситуацию"
        taskLabel="Краткое описание спора или номер заявки/дела"
      />
      <hr class="my-6 border-[#D6DAE2]" />
      <div class="flex flex-wrap gap-4 text-sm">
        <a href="/tovarnye-znaki/" class="font-semibold text-[#9E1B1E] hover:underline">Товарные знаки →</a>
        <a href="/patentovanie/" class="font-semibold text-[#9E1B1E] hover:underline">Патентование →</a>
        <a href="/dogovory-i-franshiza/" class="font-semibold text-[#9E1B1E] hover:underline">Договоры и франшиза →</a>
        <a href="/tseny-i-poshliny/" class="font-semibold text-[#9E1B1E] hover:underline">Цены и пошлины →</a>
      </div>
    </section>
  </div>
</BaseLayout>
